package com.liferay.source.formatter.dependencies;

import java.util.ArrayList;
import java.util.List;

/**
 * @author Alejandro Tardín
 */
public class TransformUtil {

	public List<String> copy(List<String> names) {
		List<String> copies = new ArrayList<>();

		for (String name : names) {
			copies.add(name);
		}

		return copies;
	}

	public List<String> map(List<String> names) {
		List<String> upperCaseNames = new ArrayList<>();

		for (String name : names) {
			upperCaseNames.add(name.toUpperCase());
		}

		return upperCaseNames;
	}

	public List<String> mapAndSkip(List<String> names) {
		List<String> trimmedNames = new ArrayList<>();

		for (String name : names) {
			if (name == null) {
				continue;
			}

			trimmedNames.add(name.trim());
		}

		return trimmedNames;
	}

	public List<String> mapAndStop(List<String> names) {
		List<String> trimmedNames = new ArrayList<>();

		for (String name : names) {
			if (name == null) {
				break;
			}

			trimmedNames.add(name.trim());
		}

		return trimmedNames;
	}

}