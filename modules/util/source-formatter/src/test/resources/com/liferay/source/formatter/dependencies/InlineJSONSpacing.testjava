package com.liferay.source.formatter.dependencies;

/**
 * Returns the entries as JSON, such as
 * {@code [{"count":3,"name":"alpha"}]}.
 *
 * @author Alejandro Tardín
 */
public class InlineJSONSpacing {

	public String test(boolean value) {
		String json1 = "{\"count\": 3, \"name\": \"alpha\"}";
		String json2 = "{ \"count\": 3 }";
		String text = value ? "yes" : "no";

		return json1 + json2 + text;
	}

}