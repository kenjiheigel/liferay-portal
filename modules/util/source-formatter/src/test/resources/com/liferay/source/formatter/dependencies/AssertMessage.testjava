package com.liferay.source.formatter.dependencies;

import org.junit.Assert;

/**
 * @author Alejandro Tardín
 */
public class AssertMessage {

	public void test(String message, String name) {
		Assert.assertEquals(message, "name", name);
		Assert.assertFalse("The name should not be empty", name.isEmpty());
		Assert.assertNotNull(message, name);
		Assert.assertTrue(message, name.startsWith("n"));
		Assert.assertTrue(name.endsWith("e"));
	}

}