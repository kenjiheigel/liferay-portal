package com.liferay.source.formatter.dependencies;

import org.junit.Test;

/**
 * @author Alejandro Tardín
 */
public class ConsecutiveMethodCallsOrderTest {

	@Test
	public void testHelperCalls() {
		_addEntry("gamma");
		_addEntry("alpha");
		_addEntry("beta");

		_addEntry("delta");

		_addEntry(
			"epsilon, an entry whose name does not fit on the line of the call");
		_addEntry("eta");
	}

	@Test
	public void testSetterCalls(Entry entry1, Entry entry2) {
		entry1.setStatus("archived");
		entry1.setModifiedTime(0);

		entry2.setName("alpha");

		entry2.setModifiedTime(0);

		entry1.setStatus("active");
		entry2.setModifiedTime(1);
	}

	private void _addEntry(String name) {
	}

	private class Entry {

		public void setModifiedTime(long modifiedTime) {
		}

		public void setName(String name) {
		}

		public void setStatus(String status) {
		}

	}

}