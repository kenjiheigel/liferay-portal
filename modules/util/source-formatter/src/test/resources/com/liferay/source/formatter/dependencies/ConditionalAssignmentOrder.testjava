package com.liferay.source.formatter.dependencies;

/**
 * @author Alejandro Tardín
 */
public class ConditionalAssignmentOrder {

	public ConditionalAssignmentOrder(ConditionalAssignmentOrder other) {
		_alpha = other._alpha;
		_delta = other._delta;

		if (other._beta == null) {
			_beta = "";
		}
		else {
			_beta = other._beta;
		}
	}

	public ConditionalAssignmentOrder(
		ConditionalAssignmentOrder other, boolean replace) {

		_alpha = other._alpha;
		_delta = other._delta;

		if (replace) {
			_beta = _delta;
		}
		else {
			_beta = other._beta;
		}
	}

	private String _alpha;
	private String _beta;
	private String _delta;

}