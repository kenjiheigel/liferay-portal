suite: Fixture
templates:
    -   templates/cronjob.yaml
tests:
    -   asserts:
            -   isKind:
                    of: CronJob
        it: "Names the job"
    -   asserts:
            -   hasDocuments:
                    count: 0
        it: Omits the job when disabled
    -   asserts:
            -   isKind:
                    of: CronJob
        it: Schedules the job