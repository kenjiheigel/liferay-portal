package com.liferay.source.formatter.dependencies;

import java.util.Map;

import org.junit.Assert;

/**
 * @author Alejandro Tardín
 */
public class LongLiteralSuffix {

	public long getTimeout() {
		return 1000L;
	}

	public void test(Map<String, Long> map) {
		long count = 5L;
		long large = 4000000000L;
		long year = 1000L * 60 * 60 * 24 * 365;

		Assert.assertEquals(Long.valueOf(1L), map.get("apple"));

		count = 3L;

		_timeout = count + large + year;
	}

	private static final long _INTERVAL = 300000L;

	private long _timeout;

}