package com.liferay.source.formatter.dependencies;

/**
 * @author Alejandro Tardín
 */
public class IndexVariableName {

	public String lone(String value) {
		int spaceIndex = value.indexOf(' ');

		return value.substring(0, spaceIndex);
	}

	public String plain(String value) {
		int index = value.indexOf(' ');

		return value.substring(index + 1);
	}

	public String range(String value) {
		int startIndex = value.indexOf('[');
		int endIndex = value.indexOf(']', startIndex);

		return value.substring(startIndex, endIndex);
	}

	public String successive(String value) {
		int firstSlashIndex = value.indexOf('/', 1);
		int secondSlashIndex = value.indexOf('/', firstSlashIndex + 1);

		return value.substring(secondSlashIndex);
	}

}