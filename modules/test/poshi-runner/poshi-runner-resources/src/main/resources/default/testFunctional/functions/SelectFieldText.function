<definition default="selectFieldText" summary="Selecting all text at '${locator1}'">
	<command name="selectFieldText">
		<execute function="Click" />

		<execute selenium="selectFieldText" />
	</command>

	<command name="selectFieldTextCopy">
		<execute function="Click" />

		<execute selenium="selectFieldTextCopy" />
	</command>

	<command name="selectFieldTextNoError">
		<execute function="Click" />

		<execute selenium="selectFieldText" />
	</command>

	<command name="selectFieldTextPaste">
		<execute function="Click" />

		<execute selenium="selectFieldPaste" />
	</command>
</definition>