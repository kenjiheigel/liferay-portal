@component-name = "portal-plugins-osgi"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property plugins.deployment.type = "osgi";
	property testray.main.component.name = "Social Networking";

	setUp {
		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Page"
		);
	}

	tearDown {
		Page.tearDownCP();
	}

	@priority = "4"
	testNetvibesWidgetPortletSmoke {
		property portlet.plugins.includes = "netvibes-widget-portlet";
		var appName = "Netvibes Widget";

		Navigator.gotoPage(
			pageName = "Test Page"
		);

		Portlet.addPG(
			portletName = "Netvibes Widget"
		);

		AntCommand.antCommand(locator1 = "build-test.xml", value1 = "remove-plugin -Dplugin.name=netvibes-widget-portlet");
	}
}