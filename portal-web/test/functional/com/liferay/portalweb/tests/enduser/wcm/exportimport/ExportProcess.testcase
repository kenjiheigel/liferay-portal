@component-name = "portal-staging"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Export/Import Framework";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "4"
	testDeleteCustomExportProcess {
		Navigator.openURL();

		LAR.configureExportSiteCP(
			larFileName = "CustomExport"
		);

		AssertClick(locator1 = "SitePagesExport#EXPORT_BUTTON", value1 = "Export");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Clear",
			rowEntry = "CustomExport"
		);
	}

	@priority = "4"
	testDeletePortletExportProcess {
		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Documents and Media"
		);

		LAR.configureExportSiteCP(
			larFileName = "DMExport"
		);

		LAR.exportSuccess();

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Clear",
			rowEntry = "DMExport"
		);
	}

	@priority = "3"
	testViewExportProcess {
		Navigator.openURL();

		LAR.configureExportSiteCP(
			larFileName = "CustomExport"
		);

		AssertClick(locator1 = "SitePagesExport#EXPORT_BUTTON", value1 = "Export");

		AssertTextEquals.assertPartialText(locator1 = "SitePagesExport#CURRENT_AND_PREVIOUS_STATUS", value1 = "Successful");

		LAR.viewProcessesInListView();

		LAR.filterCompletedProcesses();

		LAR.viewProcessesInDescendingOrder();
	}
}