	And CalendarConfiguration save
	And Navigator goto Page
		|pageName|Calendar Page|
	And CalendarScheduler view First Hour
		|firstHour|12am|
	And CalendarScheduler view Last Hour
		|lastHour|11pm|
	And CalendarScheduler select Specific Event
		|eventTitle|Calendar Event Title|
	And CalendarScheduler view Event Times Via Dialog Box
