@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Navigation";
	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	testDisplayStyleOptions {
		property portal.acceptance = "quarantine";

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page"
		);

		Navigator.gotoSitePage(
			pageName = "Site Page",
			siteName = "Site Name"
		);

		Portlet.addPG(
			portletName = "Sites Directory"
		);

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			parentSiteName = "Site Name",
			siteName = "Child SiteName 1"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page"
		);

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			parentSiteName = "Site Name",
			siteName = "Child SiteName 2"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page"
		);

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			parentSiteName = "Site Name",
			siteName = "Child SiteName 3"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page"
		);

		Navigator.gotoSitePage(
			pageName = "Site Page",
			siteName = "Site Name"
		);

		SitesDirectory.viewDefaultConfigurationPG();

		Navigator.gotoSitePage(
			pageName = "Site Page",
			siteName = "Site Name"
		);

		var siteName = return(
			TestCase.getSiteName(
				siteName = "${siteName}"
			),
			siteName
		);

		SitesDirectory.viewDescriptivePG(
			siteName = "${siteName}"
		);

		SitesDirectory.viewDescriptivePG(
			siteName = "Site Name"
		);

		SitesDirectory.configureSetupPG(
			directorySites = "Parent Level"
		);

		Navigator.gotoSitePage(
			pageName = "Site Page",
			siteName = "Site Name"
		);

		AssertTextEquals(locator1 = "Message#INFO", value1 = "No sites were found.");

		SitesDirectory.configureSetupPG(
			directoryDisplayStyle = "List Hierarchy",
			directorySites = "Top Level"
		);

		Navigator.gotoSitePage(
			pageName = "Site Page",
			siteName = "Site Name"
		);

		SitesDirectory.viewListHierarchyPG(
			availableSiteName = "${siteName}",
			childSiteName1 = "Child SiteName 1",
			childSiteName2 = "Child SiteName 2",
			childSiteName3 = "Child SiteName 3",
			currentSiteName = "Site Name"
		);
	}
}