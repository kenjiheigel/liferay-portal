definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Display Pages";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(siteName = "Test Site Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(collectionName = "Fragment Collection Name");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get('test.portal.instance');

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	test AddDisplayPage {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Navigator.gotoNavNested(navNested = "Fragment Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoDisplayPages();

		DisplayPages.add(displayPageName = "Display Page Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Fragment Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.viewAutoSaveMessage();

		PortletEntry.publish();
	}

	@priority = "5"
	test MapDisplayPageToBasicWebContent {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Navigator.gotoNavNested(navNested = "Fragment Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoDisplayPages();

		DisplayPages.add(displayPageName = "Display Page Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Fragment Collection Name",
			fragmentName = "Fragment Name"
		);

		DisplayPages.selectAssetType(
			assetType = "Web Content Article",
			subType = "Basic Web Content"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "title",
			itemName = "Title"
		);

		PortletEntry.publish();
	}

	@priority = "5"
	test UpdateDisplayPageEditableText {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Navigator.gotoNavNested(navNested = "Fragment Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoDisplayPages();

		DisplayPages.add(displayPageName = "Display Page Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Fragment Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.editFragmentText(
			fragmentName = "Fragment Name",
			id = "title",
			text = "Editing Finished"
		);

		LayoutPageTemplates.viewFragmentEditableText(
			editableText = "Editing Finished",
			fragmentName = "Fragment Name",
			id = "title"
		);
	}

	@priority = "5"
	test ViewDisplayPageViaAssetPublisher {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Navigator.gotoNavNested(navNested = "Fragment Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoDisplayPages();

		DisplayPages.add(displayPageName = "Display Page Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Fragment Collection Name",
			fragmentName = "Fragment Name"
		);

		DisplayPages.selectAssetType(
			assetType = "Web Content Article",
			subType = "Basic Web Content"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "title",
			itemName = "Title"
		);

		Button.clickPublish();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Web Content"
		);

		WebContent.addArticleCP(
			webContentContent = "Webcontent Content",
			webContentTitle = "Webcontent Title"
		);

		WebContentNavigator.gotoEditCP(webContentTitle = "Webcontent Title");

		WebContent.editDisplayPage(
			pageName = "Display Page Name",
			pageType = "Display Pages"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		SitePages.addPublicPage(pageName = "Site Page Name");

		Navigator.gotoSitePage(pageName = "Site Page Name", siteName = "Test Site Name");

		Portlet.addPG(portletName = "Asset Publisher");

		AssetPublisherPortlet.configureAssetLinkBehaviorPG(
			assetLinkBehavior = "View in Context"
		);

		DisplayPages.viewPGViaAP(
			contentList = "Webcontent Title",
			webContentContent = "Webcontent Content",
			webContentTitle = "Webcontent Title"
		);
	}

	@priority = "5"
	test ViewDisplayPageViaFriendlyURL {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Navigator.gotoNavNested(navNested = "Fragment Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		var cssSnippet = TestCase.getFileContent(fileName = "fragment_title.css");

		Fragment.typeFragmentEditor(editor = "css", templateScript = "${cssSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoDisplayPages();

		DisplayPages.add(displayPageName = "Display Page Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Fragment Collection Name",
			fragmentName = "Fragment Name"
		);

		DisplayPages.selectAssetType(
			assetType = "Web Content Article",
			subType = "Basic Web Content"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "title",
			itemName = "Title"
		);

		Button.clickPublish();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Web Content"
		);

		WebContentNavigator.gotoAddCP();

		WebContent.addCP(
			webContentContent = "Webcontent Content",
			webContentTitle = "Webcontent Title"
		);

		WebContent.editDisplayPage(
			pageName = "Display Page Name",
			pageType = "Display Pages"
		);

		Alert.viewSuccessMessage();

		DisplayPages.viewPGViaFriendlyURL(
			contentList = "Webcontent Title",
			friendlyURL = "webcontent-title",
			siteName = "Test Site Name"
		);
	}

	@priority = "4"
	test ViewDisplayPageWithComplexRichTextFragments {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Navigator.gotoNavNested(navNested = "Fragment Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_multiple_editables.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoDisplayPages();

		DisplayPages.add(displayPageName = "Display Page Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Fragment Collection Name",
			fragmentName = "Fragment Name"
		);

		DisplayPages.selectAssetType(
			assetType = "Web Content Article",
			subType = "Basic Web Content"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "test1",
			itemName = "Title"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "test2",
			itemName = "Content"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "test3",
			itemName = "Tags"
		);

		DisplayPages.mapEditableTextToAsset(
			fragmentName = "Fragment Name",
			id = "test4",
			itemName = "Publish Date"
		);

		Button.clickPublish();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Web Content"
		);

		WebContent.addArticleCP(
			webContentContent = "Webcontent Content",
			webContentTitle = "Webcontent Title"
		);

		WebContentNavigator.gotoEditCP(webContentTitle = "Webcontent Title");

		WebContent.addWithTagCP(tagNameList = "tag1,tag2,tag3");

		WebContentNavigator.gotoEditCP(webContentTitle = "Webcontent Title");

		WebContent.editDisplayPage(
			pageName = "Display Page Name",
			pageType = "Display Pages"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		SitePages.addPublicPage(pageName = "Site Page Name");

		Navigator.gotoSitePage(pageName = "Site Page Name", siteName = "Test Site Name");

		Portlet.addPG(portletName = "Asset Publisher");

		AssetPublisherPortlet.configureAssetLinkBehaviorPG(
			assetLinkBehavior = "View in Context"
		);

		DisplayPages.viewPGViaAP(
			contentList = "Webcontent Title,Webcontent Content,tag1,tag2,tag3",
			webContentContent = "Webcontent Content",
			webContentTitle = "Webcontent Title"
		);
	}
}