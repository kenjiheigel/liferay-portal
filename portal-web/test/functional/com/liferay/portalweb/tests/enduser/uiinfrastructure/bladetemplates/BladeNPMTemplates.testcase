@component-name = "portal-blade-template"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Blade Template";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Templates Page"
		);
	}

	tearDown {
		Page.tearDownCP();
	}

	@priority = "4"
	testAngularTemplateSmoke {
		property blade.templates = "angular";
		property test.name.skip.portal.instance = "BladeNPMTemplates#AngularTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.angular Portlet"
		);

		Portlet.viewPG(
			portletBody = "Hello world!",
			portletName = "com.npm.angular Portlet"
		);
	}

	@priority = "4"
	testBillboardjsTemplateSmoke {
		property blade.templates = "billboardjs";
		property test.name.skip.portal.instance = "BladeNPMTemplates#BillboardjsTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.billboardjs Portlet"
		);

		Portlet.viewPG(
			portletBody = "data1data2",
			portletName = "com.npm.billboardjs Portlet"
		);

		AssertElementPresent(locator1 = "BladeNPMTemplates#BILLBOARDJS_BODY");
	}

	@priority = "4"
	testIsomorphicTemplateSmoke {
		property blade.templates = "isomorphic";
		property test.name.skip.portal.instance = "BladeNPMTemplates#IsomorphicTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.isomorphic Portlet"
		);

		Portlet.viewPG(
			portletBody = "",
			portletName = "com.npm.isomorphic Portlet"
		);
	}

	@priority = "4"
	testJQueryTemplateSmoke {
		property blade.templates = "jquery";
		property test.name.skip.portal.instance = "BladeNPMTemplates#JQueryTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.jquery Portlet"
		);

		Portlet.viewPG(
			portletBody = "Hello World!",
			portletName = "com.npm.jquery Portlet"
		);
	}

	@priority = "4"
	testMetaljsTemplateSmoke {
		property blade.templates = "metaljs";
		property test.name.skip.portal.instance = "BladeNPMTemplates#MetaljsTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.metaljs Portlet"
		);

		Portlet.viewPG(
			portletBody = "Hello World!",
			portletName = "com.npm.metaljs Portlet"
		);
	}

	@priority = "4"
	testReactTemplateSmoke {
		property blade.templates = "react";
		property test.name.skip.portal.instance = "BladeNPMTemplates#ReactTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.react Portlet"
		);

		Portlet.viewPG(
			portletBody = "Hello World!",
			portletName = "com.npm.react Portlet"
		);
	}

	@priority = "4"
	testSimpleTemplateSmoke {
		property blade.templates = "simple";
		property test.name.skip.portal.instance = "BladeNPMTemplates#SimpleTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.simple Portlet"
		);

		Portlet.viewPG(
			portletBody = "Hello World!",
			portletName = "com.npm.simple Portlet"
		);
	}

	@priority = "4"
	testVuejsTemplateSmoke {
		property blade.templates = "vuejs";
		property test.name.skip.portal.instance = "BladeNPMTemplates#VuejsTemplateSmoke";

		Navigator.gotoPage(
			pageName = "Templates Page"
		);

		Portlet.addPG(
			portletName = "com.npm.vuejs Portlet"
		);

		Portlet.viewPG(
			portletBody = "Hello World!",
			portletName = "com.npm.vuejs Portlet"
		);
	}
}