@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(siteName = "Test Site Name");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get('test.portal.instance');

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	test AddNavigationMenuEntriesAllTypes {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		SitePages.addPublicPage(pageName = "Test Page Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Primary Menu Name 1");

		SiteNavigationMenu.addItem(item = "Page", pageName = "Test Page Name");

		SiteNavigationMenu.viewItem(itemName = "Test Page Name");

		SiteNavigationMenu.addItem(item = "Submenu", submenuName = "Submenu Name");

		SiteNavigationMenu.viewItem(itemName = "Submenu Name");

		SiteNavigationMenu.addItem(
			item = "URL",
			url = "https://www.liferay.com/",
			urlName = "Liferay"
		);

		SiteNavigationMenu.viewItem(itemName = "Liferay");
	}

	@priority = "5"
	test AddNavigationMenuEntriesNestItems {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		for (var index : list "1,2") {
			SitePages.addPublicPage(pageName = "Test Page Name ${index}");
		}

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Primary Menu Name 1");

		for (var index : list "1,2") {
			SiteNavigationMenu.addItem(item = "Page", pageName = "Test Page Name ${index}");
		}

		for (var index : list "1,2") {
			SiteNavigationMenu.viewItemOrder(
				index = "${index}",
				itemName = "Test Page Name ${index}"
			);
		}

		SiteNavigationMenu.viewItemNotNested(itemName = "Test Page Name 2");

		SiteNavigationMenu.moveItem(direction = "in", itemName = "Test Page Name 2");

		SiteNavigationMenu.viewItemNested(itemName = "Test Page Name 2");
	}

	@priority = "5"
	test AddNavigationMenuEntriesSortViewOrder {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		for (var index : list "1,2,3,4") {
			SitePages.addPublicPage(pageName = "Test Page Name ${index}");
		}

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Primary Menu Name 1");

		for (var index : list "1,2,3,4") {
			SiteNavigationMenu.addItem(item = "Page", pageName = "Test Page Name ${index}");
		}

		for (var index : list "1,2,3,4") {
			SiteNavigationMenu.viewItemOrder(
				index = "${index}",
				itemName = "Test Page Name ${index}"
			);
		}

		SiteNavigationMenu.moveItem(direction = "up", itemName = "Test Page Name 2");

		SiteNavigationMenu.viewItemOrder(index = "1", itemName = "Test Page Name 2");

		SiteNavigationMenu.viewItemOrder(index = "2", itemName = "Test Page Name 1");
	}

	@priority = "3"
	test AddPageToNavigationMenuUponCreation {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		SitePages.addPublicPage(pageName = "Test Page Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 2");

		SiteNavigationMenu.addItem(item = "Page", pageName = "Test Page Name");

		SiteNavigationMenu.viewItem(itemName = "Test Page Name");
	}

	@description = "This is a use case for LPS-75061"
	@priority = "5"
	test AddSubmenuNavigationMenu {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Primary Menu Name 1");

		SiteNavigationMenu.addItem(item = "Submenu", submenuName = "Test Submenu");

		SiteNavigationMenu.viewItem(itemName = "Test Submenu");

		SiteNavigationMenu.addItem(
			item = "URL",
			url = "https://www.liferay.com/",
			urlName = "Liferay"
		);

		SiteNavigationMenu.viewItem(itemName = "Liferay");

		SiteNavigationMenu.moveItem(direction = "up", itemName = "Liferay");

		SiteNavigationMenu.moveItem(direction = "in", itemName = "Liferay");

		SiteNavigationMenu.viewItemNested(itemName = "Liferay");

		ProductMenu.gotoSite(site = "Test Site Name");

		Page.gotoChildPagePG(childPageName = "Liferay", pageName = "Test Submenu");
	}

	@description = "This is a use case for LPS-75059."
	@priority = "4"
	test AddURLNavigationMenu {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		SitePages.addPublicPage(pageName = "Test Page Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Default");

		SiteNavigationMenu.addItem(
			item = "URL",
			url = "https://www.liferay.com/",
			urlName = "Liferay"
		);

		SiteNavigationMenu.viewItem(itemName = "Liferay");

		Navigator.openSiteURL(siteName = "Test Site Name");

		AssertClick(
			locator1 = "Home#PAGE",
			value1 = "Liferay",
			key_pageName = "Liferay"
		);

		AssertLocation(value1 = "https://www.liferay.com/");
	}

	@priority = "4"
	test ConfigurePrimaryNavigationMenu {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 2");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Primary Navigation",
			rowEntry = "Primary Menu Name 2"
		);

		SiteNavigationMenu.configureMenuType(
			currentPrimaryNavigationMenu = "Primary Menu Name 1",
			menuType = "Primary Navigation",
			navigationMenu = "Primary Menu Name 2"
		);

		SiteNavigationMenu.viewMenuType(
			menuType = "Primary Navigation",
			rowEntry = "Primary Menu Name 2"
		);
	}

	@priority = "4"
	test ConfigureSecondaryNavigationMenu {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 2");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.configureMenuType(
			menuType = "Secondary Navigation",
			navigationMenu = "Primary Menu Name 2"
		);

		SiteNavigationMenu.viewMenuType(
			menuType = "Secondary Navigation",
			rowEntry = "Primary Menu Name 2"
		);
	}

	@priority = "4"
	test ConfigureSocialNavigationMenu {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 2");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.configureMenuType(
			menuType = "Social Navigation",
			navigationMenu = "Primary Menu Name 2"
		);

		SiteNavigationMenu.viewMenuType(
			menuType = "Social Navigation",
			rowEntry = "Primary Menu Name 2"
		);
	}

	@priority = "5"
	test DeleteNavigationMenu {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.delete(menuItem = "Delete", rowEntry = "Primary Menu Name 1");

		LexiconEntry.viewNoEntry(rowEntry = "Primary Menu Name 1");
	}

	@description = "This is a usecase for LPS-76658"
	@priority = "5"
	test EditNavigationMenuPageItemName {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		for (var index : list "1,2") {
			SitePages.addPublicPage(pageName = "Site Page Name ${index}");
		}

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Default");

		SiteNavigationMenu.editItem(
			item = "Page",
			itemName = "Site Page Name 2",
			name = "Site Page Name 3"
		);

		SiteNavigationMenu.viewItem(itemName = "Site Page Name 3");

		Navigator.gotoSitePage(
			pageName = "Site Page Name 1",
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "Site Page Name 3",
			siteName = "Test Site Name"
		);

		var portalURL = PropsUtil.get('portal.url');

		AssertLocation(value1 = "${portalURL}/web/test-site-name/site-page-name-2");
	}

	@priority = "5"
	test RenameNavigationMenu {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Rename",
			rowEntry = "Primary Menu Name 1"
		);

		PortletEntry.inputName(name = "Primary Menu Name 1 Edit");

		Modal.save();

		LexiconEntry.viewEntryName(rowEntry = "Primary Menu Name 1 Edit");
	}

	@description = "This is a use case for LPS-67191."
	@priority = "5"
	test ViewNavigationMenuPropertiesSidebar {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Primary Menu Name 1");

		SiteNavigationMenu.addItem(
			item = "URL",
			url = "https://www.liferay.com/",
			urlName = "Liferay"
		);

		SiteNavigationMenu.viewItem(itemName = "Liferay");

		SiteNavigationMenu.openItemSidebar(itemName = "Liferay");
	}

	@description = "This is a test case for LPS-77912."
	@priority = "4"
	test ViewSuccessMessageAfterAddingMenuItem {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		SitePages.addPublicPage(pageName = "Test Page Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		SiteNavigationMenu.addMenu(menuName = "Primary Menu Name 1");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Navigation Menus"
		);

		LexiconEntry.gotoEntry(rowEntry = "Primary Menu Name 1");

		SiteNavigationMenu.addItem(item = "Page", pageName = "Test Page Name");

		Alert.viewSuccessMessage();
	}
}