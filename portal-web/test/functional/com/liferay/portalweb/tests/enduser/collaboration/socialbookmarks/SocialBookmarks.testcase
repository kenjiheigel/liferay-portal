@component-name = "portal-collaboration"
definition {
	property custom.properties = "default.layout.template.id=1_column";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Social Bookmarks";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			Blogs.tearDownConfigurationDisplaySettingsPG(
				pageName = "Blogs Page",
				portletName = "Blogs"
			);

			KBArticle.tearDownCP();

			Page.tearDownCP();
		}
	}

	@priority = "4"
	testChangeSocialBookmarkSitesForKBArticle {
		property osgi.app.includes = "social-bookmarks, knowledge-base";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Knowledge Base Display Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Knowledge Base Display Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		Portlet.addPG(
			portletName = "Knowledge Base Display"
		);

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Knowledge Base"
		);

		KBArticle.addCP(
			kbArticleContent = "Knowledge Base Article Content",
			kbArticleTitle = "Knowledge Base Article Title"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		KBArticle.viewViaKBDisplayPG(
			kbArticleContent = "Knowledge Base Article Content",
			kbArticleTitle = "Knowledge Base Article Title"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		SocialBookmarks.viewBookmarkMenuItems(
			socialBookmarks = "Twitter,Facebook,LinkedIn,Google+,AddThis,Delicious,Digg,Evernote,Reddit,Slashdot,StumbleUpon"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		KBArticle.viewViaKBDisplayPG(
			kbArticleContent = "Knowledge Base Article Content",
			kbArticleTitle = "Knowledge Base Article Title"
		);

		KBArticle.configureKBSocialBookmarkSites(
			disableSocialBookmarkSites = "Twitter,Reddit,Slashdot,StumbleUpon"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		SocialBookmarks.viewBookmarkMenuItems(
			socialBookmarks = "Facebook,Google+,AddThis,LinkedIn,Delicious,Digg,Evernote"
		);

		SocialBookmarks.viewBookmarksNotPresent(
			socialBookmarks = "Twitter,Reddit,Slashdot,StumbleUpon"
		);
	}

	@priority = "3"
	testViewBlogsEntryWithSocialBookmarksSites {
		property osgi.app.includes = "social-bookmarks";
		property test.assert.warning.exceptions = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Blogs Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Blogs Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoPage(
			pageName = "Blogs Page"
		);

		Portlet.addPG(
			portletName = "Blogs"
		);

		Navigator.gotoPage(
			pageName = "Blogs Page"
		);

		Blogs.addEntry(
			entryContent = "Blogs Entry Content",
			entrySubtitle = "Blogs Entry Subtitle",
			entryTitle = "Blogs Entry Title"
		);

		Navigator.gotoPage(
			pageName = "Blogs Page"
		);

		BlogsNavigator.gotoEntryPG(
			entryContent = "Blogs Entry Content",
			entryTitle = "Blogs Entry Title"
		);

		SocialBookmarks.viewDefaultSharableBookmarks();

		Blogs.disableSocialBookmarkSites(
			disableSocialBookmarkSites = "Google+,AddThis,Delicious,Digg,Evernote,Reddit,Slashdot,StumbleUpon"
		);

		Navigator.gotoPage(
			pageName = "Blogs Page"
		);

		SocialBookmarks.viewShareIconNotPresent();

		Blogs.enableSocialBookmarkSites(
			enableSocialBookmarkSites = "Google+,AddThis,Delicious,Digg,Evernote,Reddit,Slashdot,StumbleUpon"
		);

		Navigator.gotoPage(
			pageName = "Blogs Page"
		);

		BlogsNavigator.gotoEntryPG(
			entryContent = "Blogs Entry Content",
			entryTitle = "Blogs Entry Title"
		);

		SocialBookmarks.viewBookmarkMenuItems(
			socialBookmarks = "Google+,AddThis,Delicious,Digg,Evernote,Reddit,Slashdot,StumbleUpon"
		);
	}

	@priority = "3"
	testViewKBArticleWithAllSocialBookmarkSites {
		property osgi.app.includes = "social-bookmarks, knowledge-base";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Knowledge Base Display Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Knowledge Base Display Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		Portlet.addPG(
			portletName = "Knowledge Base Display"
		);

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Knowledge Base"
		);

		KBArticle.addCP(
			kbArticleContent = "Knowledge Base Article Content",
			kbArticleTitle = "Knowledge Base Article Title"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		KBArticle.viewViaKBDisplayPG(
			kbArticleContent = "Knowledge Base Article Content",
			kbArticleTitle = "Knowledge Base Article Title"
		);

		Navigator.gotoPage(
			pageName = "Knowledge Base Display Page"
		);

		SocialBookmarks.viewBookmarkMenuItems(
			socialBookmarks = "Twitter,Facebook,LinkedIn,Google+,AddThis,Delicious,Digg,Evernote,Reddit,Slashdot,StumbleUpon"
		);
	}
}