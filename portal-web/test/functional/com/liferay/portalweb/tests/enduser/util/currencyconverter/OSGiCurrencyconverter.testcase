@component-name = "portal-util-misc"
@ignore = "true"
definition {
	property osgi.app.includes = "currency-converter";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Util";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Currency Converter Page"
		);

		Navigator.gotoPage(
			pageName = "Currency Converter Page"
		);

		Portlet.addPG(
			portletName = "Currency Converter"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@priority = "2"
	testConvertCurrencyUSDToEUR {
		Navigator.gotoPage(
			pageName = "Currency Converter Page"
		);

		CurrencyConverter.convertPG(
			currencyDataFrom = "USD",
			currencyDataTo = "EUR",
			currencyFrom = "USD",
			currencyTo = "EUR",
			currencyValue = "4"
		);
	}
}