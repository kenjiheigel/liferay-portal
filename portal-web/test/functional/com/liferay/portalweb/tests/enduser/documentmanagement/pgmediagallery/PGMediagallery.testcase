@component-name = "portal-document-management"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents Management";
	var pageName = "Media Gallery Page";
	var portletName = "Media Gallery";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Media Gallery Page"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Media Gallery Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		Portlet.addPG(
			portletName = "Media Gallery"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		MGPortlet.configureShowAllPG(
			pageName = "Media Gallery Page"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMFolder.tearDownPGViaMG(
				pageName = "Media Gallery Page"
			);

			Page.tearDownCP(
				pageName = "Media Gallery Page"
			);
		}
	}

	@priority = "4"
	testAddFolder {
		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Folder Name"
		);
	}

	@priority = "4"
	testAddFolderDocument {
		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMDocument.addPGViaMG(
			mgDocumentDescription = "DM Document Description",
			mgDocumentFile = "Document_1.jpg",
			mgDocumentTitle = "DM Document Title"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMDocument.viewPGViaMG(
			mgDocumentTitle = "DM Document Title"
		);
	}

	@priority = "4"
	testAddFolders {
		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder1 Description",
			mgFolderName = "DM Folder1 Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Folder1 Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder2 Description",
			mgFolderName = "DM Folder2 Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Folder2 Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder3 Description",
			mgFolderName = "DM Folder3 Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Folder3 Name"
		);
	}

	@priority = "4"
	testAddSubfolderDocument {
		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMFolder.addSubfolderPGViaMG(
			mgSubfolderDescription = "DM Subfolder Description",
			mgSubfolderName = "DM Subfolder Name"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Subfolder Name"
		);

		DMDocument.addPGViaMG(
			mgDocumentDescription = "DM Document Description",
			mgDocumentFile = "Document_1.jpg",
			mgDocumentTitle = "DM Document Title"
		);
	}

	@priority = "4"
	testAddSubfolders {
		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMFolder.addSubfolderPGViaMG(
			mgSubfolderDescription = "DM Subfolder1 Description",
			mgSubfolderName = "DM Subfolder1 Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Subfolder1 Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMFolder.addSubfolderPGViaMG(
			mgSubfolderDescription = "DM Subfolder2 Description",
			mgSubfolderName = "DM Subfolder2 Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Subfolder2 Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMFolder.addSubfolderPGViaMG(
			mgSubfolderDescription = "DM Subfolder3 Description",
			mgSubfolderName = "DM Subfolder3 Name"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Subfolder3 Name"
		);
	}

	@priority = "5"
	testDeleteFolderDocument {
		property portal.acceptance = "false";

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMDocument.addPGViaMG(
			mgDocumentDescription = "DM Document Description",
			mgDocumentFile = "Document_1.jpg",
			mgDocumentTitle = "DM Document Title"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMDocument.deletePGViaMG(
			mgDocumentTitle = "DM Document Title"
		);
	}

	@priority = "5"
	testEditFolder {
		property portal.acceptance = "false";

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.editPGViaMG(
			mgFolderDescription = "DM Folder Description Edit",
			mgFolderDescriptionEdit = "DM Folder Description Edit",
			mgFolderName = "DM Folder Name Edit",
			mgFolderNameEdit = "DM Folder Name Edit"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.viewPGViaMG(
			mgFolderName = "DM Folder Name Edit"
		);
	}

	@priority = "5"
	testEditFolderDocument {
		property portal.acceptance = "false";

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMDocument.addPGViaMG(
			mgDocumentDescription = "DM Document Description",
			mgDocumentFile = "Document_1.jpg",
			mgDocumentTitle = "DM Document Title"
		);

		DMDocument.editPGViaMG(
			mgDocumentDescription = "DM Document Description",
			mgDocumentDescriptionEdit = "DM Document Description Edit",
			mgDocumentTitle = "DM Document Title",
			mgDocumentTitleEdit = "DM Document Title Edit"
		);
	}

	@priority = "4"
	testSearchFolderDocument {
		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		DMFolder.addPGViaMG(
			mgFolderDescription = "DM Folder Description",
			mgFolderName = "DM Folder Name"
		);

		DMFolder.gotoPGViaMG(
			mgFolderName = "DM Folder Name"
		);

		DMDocument.addPGViaMG(
			mgDocumentDescription = "DM Document Description",
			mgDocumentFile = "Document_1.jpg",
			mgDocumentTitle = "DM Document Title"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		SearchPortlet.searchPG(
			searchTerm = "DM Document Title"
		);

		SearchPortlet.viewSearchResultPG(
			searchAssetTitle = "DM Document Title",
			searchAssetType = "Document"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		SearchPortlet.searchPG(
			searchTerm = '''"DM Document Title"'''
		);

		SearchPortlet.viewSearchResultPG(
			searchAssetTitle = "DM Document Title",
			searchAssetType = "Document"
		);

		Navigator.gotoPage(
			pageName = "Media Gallery Page"
		);

		SearchPortlet.searchPG(
			searchTerm = "asdf"
		);

		SearchPortlet.viewSearchNoPG(
			searchAssetTitle = "DM Document Title",
			searchNoResults = "true",
			searchTerm = "asdf"
		);
	}
}