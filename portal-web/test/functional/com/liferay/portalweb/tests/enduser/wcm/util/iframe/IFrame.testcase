@component-name = "portal-util-misc"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "IFrame Portlet";
	property testray.main.component.name = "IFrame Portlet";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "IFrame Page"
		);

		Navigator.gotoPage(
			pageName = "IFrame Page"
		);

		Portlet.addPG(
			portletName = "IFrame"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@priority = "3"
	testViewIFramePortlet {
		Navigator.gotoPage(
			pageName = "IFrame Page"
		);

		Portlet.viewPG(
			portletBody = "Please configure this portlet to make it visible to all users.",
			portletName = "IFrame"
		);
	}
}