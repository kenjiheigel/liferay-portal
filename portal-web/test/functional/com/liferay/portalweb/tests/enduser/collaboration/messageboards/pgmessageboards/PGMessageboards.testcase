	And AssertClick the value 'My Posts' at locator 'MessageBoards#NAVIGATION_MY_POSTS'
	And AssertTextEquals the value 'Message Boards Thread Draft' at locator 'MessageBoards#THREAD_LIST_THREAD'
	Then AssertTextEquals the value 'Draft' at locator 'MessageBoards#THREAD_LIST_STATUS'
