		|siteName|${siteName}|
	And Calendar choose Site Calendar Menulist Option
		|menuListOption|RSS|
		|siteCalendarName|${siteName}|
		|siteName|${siteName}|
	And Calendar view RSS Feed Event Present
		|calendarName|${siteName}|
		|eventTitle|Current Day Event|
		|pageName|Calendar Page|
		|siteCalendarName|${siteName}|
		|siteName|${siteName}|
	And these variables
		|rssURL|selenium#getLocation()|
	And Navigator close Window
	And CalendarNavigator goto Configuration
	And CalendarConfiguration enable RSS
	And CalendarConfiguration view RSS Options Disabled
	And CalendarConfiguration save
	And Navigator goto Page
		|pageName|Calendar Page|
	And Calendar view Site Calendar No Menulist Option
		|menuListOption|RSS|
		|siteCalendarName|${siteName}|
		|siteName|${siteName}|
	Then Calendar view No RSS
		|rssURL|${rssURL}|
