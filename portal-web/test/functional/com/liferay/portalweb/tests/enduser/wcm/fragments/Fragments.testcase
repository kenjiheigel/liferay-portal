@component-name = "portal-wcm"
definition {
	property portal.upstream = "true";
	property testray.main.component.name = "Fragments";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Test Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		Collection.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	testAddCollectionFragmentWithSnippets {
		property portal.acceptance = "pending";

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = "Fragment Name"
		);
		var htmlSnippet = '''
<html>${line.separator}
<div>${line.separator}
<span class="test">This is a test.</span>${line.separator}
</div>${line.separator}
</html>''';

		Fragment.typeFragmentEditor(
			editor = "html",
			templateScript = "${htmlSnippet}"
		);
		var cssSnippet = '''
.test{${line.separator}
	color:red${line.separator}
}''';

		Fragment.typeFragmentEditor(
			editor = "css",
			templateScript = "${cssSnippet}"
		);
		var javascriptSnippet = '''
var element = document.querySelector(".test");${line.separator}${line.separator}
element.style.border='2px dashed red';
''';

		Fragment.typeFragmentEditor(
			editor = "javascript",
			templateScript = "${javascriptSnippet}"
		);

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = "Fragment Name"
		);

		AssertElementPresent(locator1 = "//div[@class='fragment-preview__frame']//span[@class='test'][contains(@style,'2px dashed red')]");

		AssertCssValue(locator1 = "//div[@class='fragment-preview__frame']//span[@class='test'][contains(@style,'2px dashed red')]", locator2 = "color", value1 = "rgba(255, 0, 0, 1)");

		SelectFrameTop();
	}

	@priority = "5"
	testDeleteFragment {
		property portal.acceptance = "pending";

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.delete(
			rowEntry = "Fragment Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.viewNoEntry(
			rowEntry = "Fragment Name"
		);
	}

	@priority = "5"
	testDeleteFragmentCollection {
		property portal.acceptance = "pending";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.delete(
			rowEntry = "Collection Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.viewNoEntry(
			rowEntry = "Collection Name"
		);
	}

	@priority = "4"
	testRenameFragment {
		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Rename",
			rowEntry = "Fragment Name"
		);

		Fragment.editFragment(
			fragmentName = "Rename Fragment"
		);

		Modal.submit();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.viewEntryName(
			rowEntry = "Rename Fragment"
		);
	}

	@priority = "5"
	testViewCannotDeleteFragmentInUse {
		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);
		var htmlSnippet = '''
<html>${line.separator}
<div>${line.separator}
<span class="test">This is a test.</span>${line.separator}
</div>${line.separator}
</html>''';

		Fragment.typeFragmentEditor(
			editor = "html",
			templateScript = "${htmlSnippet}"
		);

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		Navigator.gotoNavItem(
			navItem = "Page Templates"
		);

		Collection.addCollection(
			collectionName = "Page Template Collection"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Page Template Collection"
		);

		LayoutPageTemplates.add(
			pageTemplateName = "Page Template Name"
		);

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.viewAutoSaveMessage();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		LexiconEntry.delete(
			failure = "The fragment entry cannot be deleted because it is required by one or more page templates.",
			rowEntry = "Fragment Name"
		);
	}

	@priority = "4"
	testViewEmptyFragmentCannotBePublished {
		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);

		SiteAdmin.viewPortletTitle(
			portletTitle = "Fragment Name (Draft)"
		);

		Fragment.typeFragmentEditor(
			editor = "html",
			templateScript = ""
		);

		Fragment.typeFragmentEditor(
			editor = "css",
			templateScript = ""
		);

		Button.clickPublish();

		Alert.viewErrorMessage(
			errorMessage = "HTML content must not be empty."
		);
	}

	@priority = "4"
	testViewOnlyDraftFragmentsCanBeSaved {
		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);

		SiteAdmin.viewPortletTitle(
			portletTitle = "Fragment Name (Draft)"
		);

		PortletEntry.saveAsDraft();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		PortletEntry.viewWorkflowStatus(
			rowEntry = "Fragment Name",
			workflowStatus = "Draft"
		);

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = "Fragment Name"
		);
		var htmlSnippet = '''
<html>${line.separator}
<div>${line.separator}
<span class="test">This is a test.</span>${line.separator}
</div>${line.separator}
</html>''';

		Fragment.typeFragmentEditor(
			editor = "html",
			templateScript = "${htmlSnippet}"
		);

		PortletEntry.publish();

		AssertElementNotPresent(locator1 = "Button#SAVE_AS_DRAFT");
	}
}