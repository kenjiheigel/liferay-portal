	@priority = "3"
	testViewBlogsEntriesWithSpecialCharactersOnPublicAndPrivateVirtualHostPages {
		property test.name.skip.portal.instance = "BlogsUsecase#ViewBlogsEntriesWithSpecialCharactersOnPublicAndPrivateVirtualHostPages";
		var entryTitleSpecialCharacter = "true";
		var privatePageVirtualHostURL = "www.baker.com";

		Blogs.addEntry(
			entryContent = "Blogs Entry Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		Navigator.gotoPage(
			pageName = "Blogs Page"
		);

		BlogsNavigator.gotoEntryPG(
			entryContent = "Blogs Entry Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		BlogsEntry.viewPG(
			entryContent = "Blogs Entry Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Virtual Instances"
		);

		PortalInstances.addCP(
			mailDomain = "www.able.com",
			virtualHost = "www.able.com",
			webId = "www.able.com"
		);

		User.logoutPG();

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "test@www.able.com",
			virtualHostsURL = "http://www.able.com:8080"
		);

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Site Administration",
			portlet = "Site Settings"
		);

		Site.addVirtualHostsURLCP(
			privatePageVirtualHostURL = "${privatePageVirtualHostURL}",
			privateVirtualHosts = "true"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Public Blogs Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Public Blogs Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		SitePages.addPrivatePage(
			pageName = "Private Blogs Page"
		);

		Navigator.openPrivateURL(
			baseURL = "http://www.able.com:8080"
		);

		Portlet.addPG(
			portletName = "Blogs"
		);

		Blogs.addEntry(
			entryContent = "Blogs Entry2 Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		BlogsNavigator.gotoEntryPG(
			entryContent = "Blogs Entry2 Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		BlogsEntry.viewPG(
			entryContent = "Blogs Entry2 Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		User.logoutPG();

		User.firstLoginPG(
			password = "test",
			userEmailAddress = "test@www.able.com",
			virtualHostsURL = "http://www.baker.com:8080"
		);

		BlogsNavigator.gotoEntryPG(
			entryContent = "Blogs Entry2 Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);

		BlogsEntry.viewPG(
			entryContent = "Blogs Entry2 Content",
			entryTitle = '''Blogs Entry Title `~!@#$%^&*(){}[],.<>/?|'''
		);
	}

