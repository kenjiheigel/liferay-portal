	And FormFields view Text Value
		|fieldName|textChild|
		|fieldValue|Spanish (Spain) Child|
	And DDLRecord select Translation
		|localizedLanguage|Portuguese (Brazil)|
	And FormFields view Text Value
		|fieldName|textParent|
