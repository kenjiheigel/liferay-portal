@component-name = "portal-util-misc"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Util";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Quick Note Page"
		);

		Navigator.gotoPage(
			pageName = "Quick Note Page"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@ignore = "true"
	@priority = "2"
	testAddQuickNote {
		Portlet.addPG(
			portletName = "Quick Note"
		);

		Navigator.gotoPage(
			pageName = "Quick Note Page"
		);

		QuickNote.addPG(
			noteContent = "Test Note Content"
		);
	}
}