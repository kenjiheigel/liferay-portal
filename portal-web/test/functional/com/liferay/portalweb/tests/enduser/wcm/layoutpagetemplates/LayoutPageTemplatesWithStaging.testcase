@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Layout Page Templates";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONGroup.addGroup(groupName = "Site Name");

		Navigator.openWithAppendToBaseURL(
			urlAppend = "group/site-name/~/control_panel/manage?p_p_id=com_liferay_staging_processes_web_portlet_StagingProcessesPortlet"
		);

		Staging.activateStagingCP(siteName = "Site Name");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get('test.portal.instance');

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	test AssertPageTemplatesAreOnlyEditableInStagingView {
		Navigator.openWithAppendToBaseURL(
			urlAppend = "group/site-name-staging/~/control_panel/manage?p_p_id=com_liferay_layout_admin_web_portlet_GroupPagesPortlet"
		);

		AssertVisible(locator1 = "NavBar#NAV_ITEM_LINK", key_navItem = "Page Templates");

		Navigator.openWithAppendToBaseURL(
			urlAppend = "group/site-name/~/control_panel/manage?p_p_id=com_liferay_layout_admin_web_portlet_GroupPagesPortlet"
		);

		AssertElementNotPresent(
			locator1 = "NavBar#NAV_ITEM_LINK",
			key_navItem = "Page Templates"
		);
	}
}