@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Layout Page Templates";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(siteName = "Test Site Name");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get('test.portal.instance');

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	test AddLayoutPageTemplateRemoveFragment {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);

		Navigator.gotoNavNested(navNested = "Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_button.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.viewAutoSaveMessage();

		LayoutPageTemplates.removeFragment(fragmentName = "Fragment Name");

		LayoutPageTemplates.viewAutoSaveMessage();

		LayoutPageTemplates.viewEditorEmpty();
	}

	@priority = "5"
	test ChangeEditableImage {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);

		Navigator.gotoNavNested(navNested = "Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_image.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		var cssSnippet = TestCase.getFileContent(fileName = "fragment_image.css");

		Fragment.typeFragmentEditor(editor = "css", templateScript = "${cssSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.editFragmentImage(
			fileName = "Document_1.png",
			fragmentName = "Fragment Name"
		);
	}

	@priority = "5"
	test ChangeEditableText {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);

		Navigator.gotoNavNested(navNested = "Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.editFragmentText(
			fragmentName = "Fragment Name",
			id = "title",
			text = "Editing Finished"
		);

		LayoutPageTemplates.viewFragmentEditableText(
			editableText = "Editing Finished",
			fragmentName = "Fragment Name",
			id = "title"
		);
	}

	@priority = "5"
	test DeleteCollection {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Collection Name");

		Collection.deleteCollection(collectionName = "Collection Name");

		Collection.viewNotPresent(rowEntry = "Collection Name");
	}

	@priority = "5"
	test DeletePageTemplate {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LexiconEntry.delete(rowEntry = "Page Template Name");

		LexiconEntry.viewNoEntry(rowEntry = "Page Template Name");
	}

	@priority = "4"
	test RenameCollection {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(
			collectionDescription = "Collection Description Original",
			collectionName = "Collection Name Original"
		);

		Collection.renameCollection(
			collectionDescription = "Collection Description New",
			collectionName = "Collection Name Original",
			collectionNameEdit = "Collection Name New"
		);

		Collection.viewPresent(collectionName = "Collection Name New");
	}

	@priority = "4"
	test RenamePageTemplate {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.rename(
			pageTemplateName = "Page Template Name New",
			rowEntry = "Page Template Name"
		);

		LexiconEntry.viewEntryName(rowEntry = "Page Template Name New");
	}

	@priority = "5"
	test ReorderFragments {
		property portal.acceptance = "true";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);

		Navigator.gotoNavNested(navNested = "Collection Name");

		Fragment.addFragment(fragmentName = "Fragment 1");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		var cssSnippet = TestCase.getFileContent(fileName = "fragment_title.css");

		Fragment.typeFragmentEditor(editor = "css", templateScript = "${cssSnippet}");

		PortletEntry.publish();

		Fragment.addFragment(fragmentName = "Fragment 2");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_title.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		var cssSnippet = TestCase.getFileContent(fileName = "fragment_content.css");

		Fragment.typeFragmentEditor(editor = "css", templateScript = "${cssSnippet}");

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment 1"
		);

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment 2"
		);

		LayoutPageTemplates.viewFragmentOrder(
			fragmentName = "Fragment 1",
			position = "0"
		);

		LayoutPageTemplates.viewFragmentOrder(
			fragmentName = "Fragment 2",
			position = "1"
		);

		LayoutPageTemplates.moveFragment(
			direction = "down",
			fragmentName = "Fragment 1"
		);

		LayoutPageTemplates.viewFragmentOrder(
			fragmentName = "Fragment 1",
			position = "1"
		);

		LayoutPageTemplates.viewFragmentOrder(
			fragmentName = "Fragment 2",
			position = "0"
		);

		LayoutPageTemplates.moveFragment(direction = "up", fragmentName = "Fragment 1");

		LayoutPageTemplates.viewFragmentOrder(
			fragmentName = "Fragment 1",
			position = "0"
		);

		LayoutPageTemplates.viewFragmentOrder(
			fragmentName = "Fragment 2",
			position = "1"
		);
	}

	@priority = "4"
	test ViewDraftFragmentDoesNotDisplayInSidebar {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);

		Navigator.gotoNavNested(navNested = "Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		LayoutPageTemplates.viewCollectionNotPresent(collectionName = "Collection Name");
	}
}