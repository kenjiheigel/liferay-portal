@component-name = "portal-wcm"
definition {
	property portal.upstream = "true";
	property testray.main.component.name = "Layout Page Templates";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Test Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Fragments"
		);

		Collection.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Collection Name"
		);

		Fragment.addFragment(
			fragmentName = "Fragment Name"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	testAddLayoutPageTemplateRemoveFragment {
		var htmlSnippet = '''
<html>${line.separator}
<div>${line.separator}
<span class="test">This is a test.</span>${line.separator}
</div>${line.separator}
</html>''';

		Fragment.typeFragmentEditor(
			editor = "html",
			templateScript = "${htmlSnippet}"
		);

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		Navigator.gotoNavItem(
			navItem = "Page Templates"
		);

		Collection.addCollection(
			collectionName = "Page Template Collection"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Page Template Collection"
		);

		LayoutPageTemplates.add(
			pageTemplateName = "Page Template Name"
		);

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.viewAutoSaveMessage();

		LayoutPageTemplates.removeFragment(
			fragmentName = "Fragment Name"
		);

		LayoutPageTemplates.viewAutoSaveMessage();

		Portlet.viewEmptyMessage(
			message = "This layout page template is empty."
		);
	}

	@priority = "4"
	testViewDraftFragmentDoesNotDisplayInSidebar {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		Navigator.gotoNavItem(
			navItem = "Page Templates"
		);

		Collection.addCollection(
			collectionName = "Page Template Collection"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Page Template Collection"
		);

		LayoutPageTemplates.add(
			pageTemplateName = "Page Template Name"
		);

		LayoutPageTemplates.viewCollectionNotPresent(
			collectionName = "Collection Name"
		);
	}
}