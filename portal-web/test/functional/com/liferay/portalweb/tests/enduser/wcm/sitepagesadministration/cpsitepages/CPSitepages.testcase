	@priority = "4"
	testCopyApplicationsFromPageToPage {
		property testray.component.names = "Site Pages Administration";

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page"
		);

		SitePages.addPublicPage(
			pageName = "Blog Page"
		);

		Navigator.gotoSitePage(
			pageName = "Blog Page",
			siteName = "Site Name"
		);

		Portlet.addPG(
			portletName = "Blogs"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		Page.copyApplicationsFromPageToPage(
			pageName = "Blog Page",
			pageNameCopy = "Site Page"
		);

		Navigator.gotoSitePage(
			pageName = "Blog Page",
			siteName = "Site Name"
		);

		Portlet.viewNoSpecificPG(
			portletName = "Blogs"
		);
	}

	@priority = "5"
	testDeleteSitePages {
		property portal.acceptance = "true";
		property testray.component.names = "Site Pages Administration";

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		for (pageName : "Site Page 1,Site Page 2,Site Page 3") {
			SitePages.addPublicPage(
				pageName = "${pageName}"
			);
		}

		SitePages.deletePage(
			pageName = "Site Page 2"
		);
	}

