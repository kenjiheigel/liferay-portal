@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Site Pages Administration";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			Page.tearDownCP();

			Site.tearDownCP();

			User.tearDownCP();
		}
	}

	@priority = "3"
	testAddPageMultiplePagesToSite {
		property testray.component.names = "Site Pages Administration";

		var siteName = return(
			TestCase.getSiteName(
				siteName = "${siteName}"
			),
			siteName
		);

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page 1"
		);

		SitePages.addPublicPage(
			pageName = "Site Page 2"
		);

		SitePages.addPublicPage(
			pageName = "Site Page 3"
		);

		Page.tearDownCP();
	}

	@priority = "4"
	testAddPagesFullPageApplication {
		property testray.component.names = "Site Pages Administration";

		for (portlet : "Blogs,Documents and Media,Wiki,Media Gallery,Message Boards,Dynamic Data Mapping Form,Hello Soy Portlet,RSS") {
			ProductMenu.gotoPortlet(
				category = "Build",
				panel = "Site Administration",
				portlet = "Site Pages"
			);

			SitePages.addPublicPage(
				pageName = "${portlet} Full Page Application",
				sitePageType = "Full Page Application"
			);

			SitePages.configurePage(
				pageName = "${portlet} Full Page Application",
				portlet = "${portlet}",
				privacy = "Public",
				sitePageType = "Full Page Application"
			);

			Navigator.gotoPage(
				pageName = "${portlet} Full Page Application"
			);

			if ("${portlet}" == "Dynamic Data Mapping Form") {
				AssertTextEquals.assertTextCaseInsensitive(locator1 = "Home#PAGE_COLUMN_PORTLET_COLUMN_1_PORTLET_TITLE", value1 = "Form", key_portletTitleName = "Form");
			}
			else if ("${portlet}" == "RSS") {
				AssertTextEquals.assertTextCaseInsensitive(locator1 = "Home#PAGE_COLUMN_PORTLET_COLUMN_1_PORTLET_TITLE", value1 = "RSS Publisher", key_portletTitleName = "RSS Publisher");
			}
			else {
				AssertTextEquals.assertTextCaseInsensitive(locator1 = "Home#PAGE_COLUMN_PORTLET_COLUMN_1_PORTLET_TITLE", value1 = "${portlet}", key_portletTitleName = "${portlet}");
			}

			AssertElementNotPresent(locator1 = "ControlMenu#ADD");
		}
	}

	@priority = "4"
	testAddPageViaNavigationMenu {
		var portalURL = "TestPropsUtil.get('portal.url')";

		NavigationMenu.gotoAddPage();

		SitePages._addPage(
			pageName = "Test Page Name"
		);

		Navigator.gotoPage(
			pageName = "Test Page Name"
		);

		AssertLocation(value1 = "${portalURL}/web/guest/test-page-name");
	}

	@priority = "3"
	testAddPageWithEscapeCharacter {
		property testray.component.names = "Site Pages Administration";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Tester's Page"
		);
	}

	@priority = "3"
	testAddPageWithMultipleChildPagesToSite {
		property testray.component.names = "Site Pages Administration";

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Site Page"
		);

		for (childPageName : "Site Child Page 1,Site Child Page 2,Site Child Page 3") {
			SitePages.addPublicChildPage(
				childPageName = "${childPageName}",
				parentPageName = "Site Page"
			);
		}

		for (childPageName : "Site Child Page 1,Site Child Page 2,Site Child Page 3") {
			Page.view(
				depth = "1",
				pageName = "${childPageName}",
				privacy = "Public"
			);
		}
	}

