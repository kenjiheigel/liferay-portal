	@description = "This is a use case for LPS-65365."
	@priority = "5"
	testViewNoHTMLXSS {
		property custom.properties = "message.boards.message.formats.default=html";

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

