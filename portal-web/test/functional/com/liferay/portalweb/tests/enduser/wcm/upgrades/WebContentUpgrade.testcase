@component-name = "portal-upgrades"
definition {
	property ignore.errors = "Plugin security management is not enabled. Enable a security manager, then restart.";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Upgrades WEM,Web Content Administration";
	property testray.main.component.name = "Upgrades WEM";

	setUp {
		SignIn.signIn();

		Smoke.viewWelcomePage();

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search"
		);

		SearchAdministration.executeSearchActions(
			actionsDescription = "Reindex all search indexes."
		);
	}

	@description = "This is a use case for LPS-75561."
	@priority = "5"
	testViewLayoutArchive621015 {
		property data.archive.type = "data-archive-pages-administration";
		property portal.version = "6.2.10.15";

		Navigator.openURL();

		Portlet.addPG(
			portletName = "Web Content Display"
		);

		AssertTextNotPresent(value1 = "There was an unexpected error. Please refresh the current page.");
	}

	@description = "This is a use case for LPS-75561."
	@priority = "5"
	testViewLayoutArchive625 {
		property data.archive.type = "data-archive-pages-administration";
		property portal.version = "6.2.5";

		Navigator.openURL();

		Portlet.addPG(
			portletName = "Web Content Display"
		);

		AssertTextNotPresent(value1 = "There was an unexpected error. Please refresh the current page.");
	}

	@priority = "5"
	testViewWebContentArchive6012 {
		property data.archive.type = "data-archive-web-content-draft";
		property portal.version = "6.0.12";

		Upgrade.addWCStructureAndTemplate();

		Upgrade.publishWCDraft();
	}

	@priority = "5"
	testViewWebContentArchive612 {
		property data.archive.type = "data-archive-web-content-draft";
		property portal.version = "6.1.2";

		Upgrade.addWCStructureAndTemplate();

		Upgrade.publishWCDraft();
	}

	@priority = "5"
	testViewWebContentArchive6130 {
		property data.archive.type = "data-archive-web-content-draft";
		property portal.version = "6.1.30";

		Upgrade.addWCStructureAndTemplate();

		Upgrade.publishWCDraft();
	}

	@priority = "5"
	testViewWebContentArchive621015 {
		property data.archive.type = "data-archive-web-content-draft";
		property portal.version = "6.2.10.15";

		Upgrade.addWCStructureAndTemplate();

		Upgrade.publishWCDraft();
	}

	@priority = "5"
	testViewWebContentArchive623 {
		property data.archive.type = "data-archive-web-content-draft";
		property portal.version = "6.2.3";

		Upgrade.addWCStructureAndTemplate();

		Upgrade.publishWCDraft();
	}

	@priority = "5"
	testViewWebContentArchive625 {
		property data.archive.type = "data-archive-web-content-draft";
		property portal.version = "6.2.5";

		Upgrade.addWCStructureAndTemplate();

		Upgrade.publishWCDraft();
	}
}