@component-name = "portal-upgrades"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property ignore.errors = "Plugin security management is not enabled. Enable a security manager, then restart.";
	property testray.main.component.name = "Upgrades FW";

	setUp {
		SignIn.signIn();

		Smoke.viewWelcomePage();

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search"
		);

		SearchAdministration.executeSearchActions(
			actionsDescription = "Reindex all search indexes."
		);
	}

	@priority = "5"
	testViewWorkflowArchive6012 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "6.0.12";

		Upgrade.approveWorkflow();
	}

	@priority = "5"
	testViewWorkflowArchive612 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "6.1.2";

		Upgrade.approveWorkflow();
	}

	@priority = "5"
	testViewWorkflowArchive6130 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "6.1.30";

		Upgrade.approveWorkflow();
	}

	@priority = "5"
	testViewWorkflowArchive621015 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "6.2.10.15";

		Upgrade.approveWorkflow();

		Upgrade.publishWorkflowDefinition();
	}

	@priority = "5"
	testViewWorkflowArchive623 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "6.2.3";

		Upgrade.approveWorkflow();
	}

	@priority = "5"
	testViewWorkflowArchive625 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "6.2.5";

		Upgrade.approveWorkflow();
	}

	@ignore = "true"
	@priority = "5"
	testViewWorkflowArchive70106 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "7.2.10.6";

		Upgrade.approveWorkflow();

		Upgrade.publishWorkflowDefinition();
	}

	@ignore = "true"
	@priority = "5"
	testViewWorkflowArchive704 {
		property data.archive.type = "data-archive-workflow";
		property portal.version = "7.0.4";

		Upgrade.approveWorkflow();
	}
}