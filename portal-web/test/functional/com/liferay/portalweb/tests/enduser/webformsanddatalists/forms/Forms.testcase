	And ProductMenu goto Sites Content
		|portlet|Forms|
	And FormsAdminNavigator goto Edit
		|formName|Created Form Name|
	And FormsAdminNavigator goto Edit Field
		|fieldName|TextFieldWithAutocomplete|
	And Form goto Advanced Tab
	And Form goto Autocomplete Configuration
	And Form edit Field Data Provider
		|dataProvider|Country Names|
		|dataProviderOutput|Countries Full Name|
	And Form close Sidebar
	And Form save
	And Page add
