@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Content Pages";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(siteName = "Test Site Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Page Fragments"
		);

		Fragment.addCollection(
			collectionDescription = "Collection Description",
			collectionName = "Collection Name"
		);
	}

	tearDown {
		var testPortalInstance = PropsUtil.get('test.portal.instance');

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = "5"
	test AddContentPage {
		property portal.acceptance = "true";

		Navigator.gotoNavNested(navNested = "Collection Name");

		Fragment.addFragment(fragmentName = "Fragment Name");

		var htmlSnippet = TestCase.getFileContent(fileName = "fragment_button.html");

		Fragment.typeFragmentEditor(editor = "html", templateScript = "${htmlSnippet}");

		var cssSnippet = TestCase.getFileContent(fileName = "fragment_button.css");

		Fragment.typeFragmentEditor(editor = "css", templateScript = "${cssSnippet}");

		var javascriptSnippet = TestCase.getFileContent(fileName = "fragment_button.js");

		Fragment.typeFragmentEditor(
			editor = "javascript",
			templateScript = "${javascriptSnippet}"
		);

		Button.clickPublish();

		ProductMenu.gotoSite(site = "Test Site Name");

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPageTemplates();

		LayoutPageTemplates.addCollection(collectionName = "Page Template Collection");

		Navigator.gotoNavNested(navNested = "Page Template Collection");

		LayoutPageTemplates.add(pageTemplateName = "Page Template Name");

		LayoutPageTemplates.selectFragment(
			collectionName = "Collection Name",
			fragmentName = "Fragment Name"
		);

		Button.clickPublish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Pages"
		);

		NavItem.gotoPages();

		ContentPages.addPage(
			pageName = "Test Page Name",
			pageTemplateName = "Page Template Name"
		);

		Navigator.gotoSitePage(pageName = "Test Page Name", siteName = "Test Site Name");

		for (var button : list "Submit,Cancel") {
			Button.viewPresent(button = "${button}");
		}

		Button.clickNoError(button = "Submit");

		Confirm(value1 = "Form submitted");
	}
}