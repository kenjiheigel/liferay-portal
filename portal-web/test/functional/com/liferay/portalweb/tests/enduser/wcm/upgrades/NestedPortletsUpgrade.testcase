@component-name = "portal-upgrades"
definition {
	property ignore.errors = "Plugin security management is not enabled. Enable a security manager, then restart.";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Nested Portlets,Upgrades WEM";
	property testray.main.component.name = "Upgrades WEM";

	setUp {
		SignIn.signIn();

		Smoke.viewWelcomePage();

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search"
		);

		SearchAdministration.executeSearchActions(
			actionsDescription = "Reindex all search indexes."
		);
	}

	@priority = "5"
	testViewNestedPortletsArchive6012 {
		property data.archive.type = "data-archive-nested-portlets";
		property portal.version = "6.0.12";

		Upgrade.viewNestedPortlets();
	}

	@priority = "5"
	testViewNestedPortletsArchive612 {
		property data.archive.type = "data-archive-nested-portlets";
		property portal.version = "6.1.2";

		Upgrade.viewNestedPortlets();
	}

	@priority = "5"
	testViewNestedPortletsArchive6130 {
		property data.archive.type = "data-archive-nested-portlets";
		property portal.version = "6.1.30";

		Upgrade.viewNestedPortlets();
	}

	@priority = "5"
	testViewNestedPortletsArchive621015 {
		property data.archive.type = "data-archive-nested-portlets";
		property portal.version = "6.2.10.15";

		Upgrade.viewNestedPortlets();
	}

	@priority = "5"
	testViewNestedPortletsArchive623 {
		property data.archive.type = "data-archive-nested-portlets";
		property portal.version = "6.2.3";

		Upgrade.viewNestedPortlets();
	}

	@priority = "5"
	testViewNestedPortletsArchive625 {
		property data.archive.type = "data-archive-nested-portlets";
		property portal.version = "6.2.5";

		Upgrade.viewNestedPortlets();
	}

	@description = "This is a use case for LPS-66141."
	@priority = "5"
	testViewStagingNestedPortletsArchive621015 {
		property data.archive.type = "data-archive-staging-nested-portlets";
		property portal.version = "6.2.10.15";

		Upgrade.viewStagingNestedPortlets();
	}

	@description = "This is a use case for LPS-66141."
	@priority = "5"
	testViewStagingNestedPortletsArchive625 {
		property data.archive.type = "data-archive-staging-nested-portlets";
		property portal.version = "6.2.5";

		Upgrade.viewStagingNestedPortlets();
	}
}