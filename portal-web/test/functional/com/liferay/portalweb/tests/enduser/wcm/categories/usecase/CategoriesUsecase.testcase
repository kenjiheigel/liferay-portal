	@priority = "3"
	testViewFlattenedTreeCategoryNavigationDisplayStyle {
		property test.name.skip.portal.instance = "CategoriesUsecase#ViewFlattenedTreeCategoryNavigationDisplayStyle";

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "System Settings"
		);

		SystemSettings.gotoConfiguration(
			configurationCategory = "Assets",
			configurationName = "Asset Categories Web",
			configurationScope = "System Scope"
		);

		SystemSettings.configureDisplayStyle(
			displayStyle = "Flattened Tree"
		);

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		Category.addCP(
			categoryName = "Category Name",
			vocabularyName = "Topic"
