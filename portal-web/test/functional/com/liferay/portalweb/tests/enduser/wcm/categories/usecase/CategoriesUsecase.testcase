	@priority = "4"
	testSearchVocabulary {
		property testray.component.names = "Categories";

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		Vocabulary.addCP(
			vocabularyDescription = "Sushi",
			vocabularyName = "Food Vocab"
		);

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		Vocabulary.addCP(
			vocabularyDescription = "Futbol",
			vocabularyName = "Sport Vocab"
		);

		for (vocabularyName : "Food,Sport") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Categorization",
				panel = "Site Administration",
				portlet = "Categories"
			);

			Search.searchCP(
				searchTerm = "${vocabularyName}"
			);

			Vocabulary.viewSearchResultsCP(
				vocabularyNameList = "${vocabularyName} Vocab"
			);
		}

		for (vocabularyDescription : "Sushi,Futbol") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Categorization",
				panel = "Site Administration",
				portlet = "Categories"
			);

			Search.searchCP(
				searchTerm = "${vocabularyDescription}"
			);

			Vocabulary.viewSearchResultsCP(
				vocabularyDefinitionList = "${vocabularyDescription}"
			);
		}

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		Search.searchCP(
			searchTerm = "Vocab"
		);

		Vocabulary.viewSearchResultsCP(
			vocabularyDefinitionList = "Sushi,Futbol",
			vocabularyNameList = "Food Vocab,Sport Vocab"
		);
	}

