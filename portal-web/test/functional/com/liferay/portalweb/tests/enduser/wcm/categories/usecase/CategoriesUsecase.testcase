		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		Search.searchCP(searchTerm = "Vocab");

		Vocabulary.viewSearchResultsCP(
			vocabularyDefinitionList = "Sushi,Futbol",
			vocabularyNameList = "Food Vocab,Sport Vocab"
		);
	}

