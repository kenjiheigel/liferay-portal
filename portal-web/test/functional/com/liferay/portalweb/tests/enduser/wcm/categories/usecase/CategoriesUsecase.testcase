			panel = "Site Administration",
			portlet = "Categories"
		);

		Subcategory.addCP(
			categoryName = "Category Name",
			subcategoryName = "Subcategory Name",
			vocabularyName = "Topic"
		);

		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		LexiconEntry.gotoEntry(
			rowEntry = "Topic"
		);

		Category.viewPath(
			categoryName = "Category Name",
			path = "Topic > Category Name"
		);

		Category.viewPath(
			categoryName = "Subcategory Name",
			path = "Topic > Category Name > Subcategory Name"
		);
	}

