	@priority = "4"
	testEditBasicWebContentStructureAndTemplate {
		property testray.component.names = "Web Content Administration";

		ProductMenu.gotoSite(
			site = "Global"
		);

		ProductMenu.gotoPortlet(
			category = "Content",
			panel = "Site Administration",
			portlet = "Web Content"
		);

