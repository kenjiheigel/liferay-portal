@component-name = "portal-collaboration"
definition {
	property custom.properties = "default.layout.template.id=1_column";
	property osgi.app.includes = "my-subscriptions";
	property portal.release = "true";
	property portal.upstream = "true";
	property plugins.deployment.type = "osgi";
	property testray.main.component.name = "My Subscriptions";
	property test.assert.warning.exceptions = "true";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "My Subscriptions Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "My Subscriptions Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoPage(
			pageName = "My Subscriptions Page"
		);

		Portlet.addPG(
			portletName = "My Subscriptions"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Page.tearDownCP();
		}
	}

	testSubscribeAndUnsubscribetoBookmarksRootFolder {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Bookmarks Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Bookmarks Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoPage(
			pageName = "Bookmarks Page"
		);

		Portlet.addPG(
			portletName = "Bookmarks"
		);

		Subscriptions.subscribeViaInfoPanelPG();

		Navigator.gotoPage(
			pageName = "My Subscriptions Page"
		);

		Subscriptions.viewSubscription(
			assetName = "Bookmarks Folder",
			assetTitle = "Home",
			assetType = "Bookmarks Folder"
		);

		Subscriptions.unsubscribeViaMySubscriptions(
			rowNumber = "1"
		);

		Navigator.gotoPage(
			pageName = "My Subscriptions Page"
		);

		Subscriptions.viewDefaultPG();

		Navigator.gotoPage(
			pageName = "Bookmarks Page"
		);

		Subscriptions.viewUnsubscribedViaInfoPanel();
	}
}