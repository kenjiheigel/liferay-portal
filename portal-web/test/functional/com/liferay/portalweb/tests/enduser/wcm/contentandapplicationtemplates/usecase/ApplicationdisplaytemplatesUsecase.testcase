@component-name = "portal-wcm"
definition {
	property custom.properties = "default.layout.template.id=1_column";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Content and Application Templates";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Site.addBlankCP(
			siteName = "Test Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "ADT Test Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "ADT Test Page",
			privacy = "Public",
			sitePageType = "Layout"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			User.logoutAndLoginPG(
				userLoginEmailAddress = "test@liferay.com",
				userLoginFullName = "Test Test"
			);

			Site.tearDownCP();
		}
	}

	@priority = "5"
	testAddRSSADTViaPortletConfiguration {
		property portal.acceptance = "quarantine";
		property testray.component.names = "Content and Application Templates,RSS";

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Portlet.addPG(
			portletName = "RSS Publisher"
		);

		Portlet.gotoPortletOptions(
			portletName = "RSS Publisher",
			portletOption = "Configuration"
		);

		RSSPortlet.addFeed(
			feedRowIndexNumber = "0",
			feedTitle = "Latimes > Technology News",
			feedType = "file",
			feedUrlLink = "rss2.0.xml"
		);

		PortletEntry.save();

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Portlet.gotoPortletOptions(
			portletName = "RSS Publisher",
			portletOption = "Configuration"
		);

		ApplicationDisplayTemplates.addManualViaRSS(
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		RSSPortlet.waitForRSSLoad();

		ApplicationDisplayTemplates.selectPortletADT(
			templateName = "RSS Test ADT"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		RSSPortlet.waitForRSSLoad();

		RSSPortlet.viewCustomADT(
			feedContentTitle = "Technology"
		);
	}

	@priority = "3"
	testAddRSSADTWithCorruptScript {
		property testray.component.names = "Content and Application Templates,RSS";

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Portlet.addPG(
			portletName = "RSS Publisher"
		);

		Portlet.gotoPortletOptions(
			portletName = "RSS Publisher",
			portletOption = "Configuration"
		);

		RSSPortlet.addFeed(
			feedRowIndexNumber = "0",
			feedTitle = "Latimes > Technology News",
			feedType = "file",
			feedUrlLink = "rss2.0.xml"
		);

		PortletEntry.save();

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		ApplicationDisplayTemplates.addPG(
			adtFile = "adt_rss_navigation_corrupt.ftl",
			adtType = "RSS",
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		ApplicationDisplayTemplates.selectPortletADT(
			templateName = "RSS Test ADT"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		RSSPortlet.viewCorruptScript();
	}

