	@priority = "3"
	testADTStagingCategoriesNavigation {
		property testray.component.names = "Categories,Content and Application Templates,Staging";

		ProductMenu.gotoSite(
			site = "Test Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Categorization",
			panel = "Site Administration",
			portlet = "Categories"
		);

		Vocabulary.addCP(
			vocabularyName = "Vocabulary Name"
		);

		Category.addCP(
			categoryName = "Category Name",
			vocabularyName = "Vocabulary Name"
		);

		Navigator.openSiteURL(
			siteName = "Test Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Publishing",
			panel = "Site Administration",
			portlet = "Staging"
		);

		Staging.activateStagingCP(
			siteName = "Test Site Name"
		);

		Navigator.gotoStagedSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Portlet.addPG(
			portletName = "Categories Navigation"
		);

		Navigator.gotoStagedSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		ApplicationDisplayTemplates.addPG(
			adtFile = "adt_categories_navigation_multi_column.ftl",
			adtType = "Categories Navigation",
			siteName = "Test Site Name"
		);

		Navigator.gotoStagedSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		CategoriesNavigationPortlet.viewDefaultPG(
			categoryName = "Category Name",
			vocabularyName = "Vocabulary Name"
		);

		ApplicationDisplayTemplates.selectPortletADT(
			templateName = "Categories Navigation Test ADT"
		);

		Navigator.gotoStagedSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		CategoriesNavigationPortlet.viewCustomADTMultiColumnPG(
			categoryName = "Category Name",
			vocabularyName = "Vocabulary Name"
		);

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		CategoriesNavigationPortlet.viewCustomADTMultiColumnPG(
			categoryName = "Category Name",
			vocabularyName = "Vocabulary Name"
		);
	}

	@priority = "5"
	testADTTagsNavigationPortlet {
		property portal.acceptance = "true";
		property testray.component.names = "Content and Application Templates,Tags";

		Navigator.openSiteURL(
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Portlet.addPG(
			portletName = "Tags Navigation"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Blogs Test Page",
			sitePageType = "Layout"
		);

		SitePages.configurePage(
			columnName = "1 Column",
			pageName = "Blogs Test Page",
			privacy = "Public",
			sitePageType = "Layout"
		);

		Navigator.gotoSitePage(
			pageName = "Blogs Test Page",
			siteName = "Test Site Name"
		);

		Portlet.addPG(
			portletName = "Blogs"
		);

		Navigator.gotoSitePage(
			pageName = "Blogs Test Page",
			siteName = "Test Site Name"
		);

		Blogs.addEntryWithTags(
			entryContent = "Entry Content",
			entryTitle = "Entry Title",
			tagNameList = "tag name 1,tag name 2,tag name 3"
		);

		Navigator.gotoSitePage(
			pageName = "Blogs Test Page",
			siteName = "Test Site Name"
		);

		Blogs.addEntryWithTags(
			entryContent = "Entry Content",
			entryTitle = "Entry Title",
			tagNameList = "tag name 2,tag name 3"
		);

		Navigator.gotoSitePage(
			pageName = "Blogs Test Page",
			siteName = "Test Site Name"
		);

		Blogs.addEntryWithTags(
			entryContent = "Entry Content",
			entryTitle = "Entry Title",
			tagNameList = "tag name 3"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		TagsNavigationPortlet.viewDefaultPG(
			tagNameList = "tag name 1,tag name 2,tag name 3"
		);

		ApplicationDisplayTemplates.addPG(
			adtFile = "adt_tags_color.ftl",
			adtType = "Tags Navigation",
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		ApplicationDisplayTemplates.selectPortletADT(
			templateName = "Tags Navigation Test ADT"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		TagsNavigationPortlet.viewADTColorByPopularityPG(
			adtTagColor = "green",
			tagName = "tag name 1"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		TagsNavigationPortlet.viewADTColorByPopularityPG(
			adtTagColor = "orange",
			tagName = "tag name 2"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		TagsNavigationPortlet.viewADTColorByPopularityPG(
			adtTagColor = "red",
			tagName = "tag name 3"
		);
	}

	@priority = "3"
	testADTWiki {
		property testray.component.names = "Content and Application Templates,Wiki";

		Navigator.openSiteURL(
			siteName = "Test Site Name"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		Portlet.addPG(
			portletName = "Wiki"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		WikiPage.addFrontPagePG(
			wikiPageContent = "Test Wiki Content"
		);

		WikiNavigator.gotoFrontPagePG();

		WikiPage.viewFrontPageDefaultADTPG(
			wikiPageContent = "Test Wiki Content"
		);

		Navigator.openSiteURL(
			siteName = "Test Site Name"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Application Display Templates"
		);

		ApplicationDisplayTemplates.addCP(
			adtFile = "adt_wiki_social.ftl",
			adtType = "Wiki"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		ApplicationDisplayTemplates.selectPortletADT(
			portletName = "Wiki",
			templateName = "Wiki Test ADT"
		);

		Navigator.gotoSitePage(
			pageName = "ADT Test Page",
			siteName = "Test Site Name"
		);

		WikiPage.viewCustomADTSocialPG(
			wikiPageContent = "Test Wiki Content"
		);
	}
}