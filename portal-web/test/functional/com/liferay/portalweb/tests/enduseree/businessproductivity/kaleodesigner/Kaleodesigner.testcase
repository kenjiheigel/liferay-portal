	@description = "This is a use case for LPS-37209."
	@priority = "4"
	testConfigureTaskTimersViaSourceTab {

		var fileContent = return(
			TestCase.getFileContent(
				fileName = "workflow_definition_task_timers.xml"
			),
			fileContent
		);

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Workflow"
		);

		Workflow.addNewDefinition(
			workflowDefinitionTitle = "New Workflow Definition Title"
		);

		KaleoDesigner.addNodeViaSourceXML(
			sourceXML = "${fileContent}"
		);

		KaleoDesigner.selectNode(
			nodeNodeLabel = "__TIMER_REVIEW__"
		);

		KaleoDesigner.viewNodeTimer(
			blockerName = "timer 1 action",
			blocking = "false",
			durationTime1 = "1",
			durationTime2 = "2",
			timerName = "timer 1"
		);
	}

	@description = "This is a use case for LPS-37209."
	@priority = "4"
	testConfigureTaskTimersViaViewTab {

