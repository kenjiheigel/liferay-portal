		KaleoDesigner.viewSourceXMLLine(
			kdSourceXML = '''<name>Timer Name</name>''',
			line = "21"
		);

		KaleoDesigner.viewSourceXMLLine(
			kdSourceXML = '''<duration>5</duration>''',
			line = "24"
		);

		KaleoDesigner.viewSourceXMLLine(
			kdSourceXML = '''<scale>hour</scale>''',
			line = "25"
		);

		KaleoDesigner.viewSourceXMLLine(
			kdSourceXML = '''<duration>6</duration>''',
			line = "28"
		);

		KaleoDesigner.viewSourceXMLLine(
			kdSourceXML = '''<scale>hour</scale>''',
			line = "29"
		);

		KaleoDesigner.viewSourceXMLLine(
