@component-name = "portal-smoke"
definition {

	property portal.smoke = "kenji";
	property testray.main.component.name = "Smoke";

	setUp {
		Open(locator1 = "http://github.com");
	}

	test Test1 {
		Pause(locator1 = "1000");

		echo("this one passes");
	}

	test Test2 {
		Pause(locator1 = "1000");

		fail("fake failure");
	}

	test Test3 {
		Pause(locator1 = "1000");

		fail("fake failure");
	}

	tearDown {
		Pause(locator1 = "1000");

		echo("Fake teardown");
	}

}