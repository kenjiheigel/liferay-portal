@component-name = "portal-legacy"
definition {
	property testray.main.component.name = "Plugin Installer";

	setUp {
		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Page"
		);
	}

	tearDown {
		Page.tearDownCP();
	}

	@priority = "4"
	testWSRPPortletSmoke {
		property portlet.plugins.includes = "wsrp-portlet";
		var appName = "WSRP";

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "WSRP Admin"
		);

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "App Manager"
		);

		AppManager.uninstallAppCP(
			appName = "${appName}"
		);

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "App Manager"
		);

		AppManager.viewUninstallAppCP(
			appName = "${appName}"
		);
	}
}