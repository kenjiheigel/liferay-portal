@component-name = "portal-plugins-deployment"
definition {
	property testray.main.component.name = "Plugin Installer";

	setUp {
		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Page"
		);
	}

	tearDown {
		Page.tearDownCP();
	}

	@priority = "4"
	testMailPortletSmoke {
		property portlet.plugins.includes = "mail-portlet";
		var appName = "Mail";

		Navigator.gotoPage(
			pageName = "Test Page"
		);

		Portlet.addPG(
			portletName = "Mail"
		);

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "App Manager"
		);

		AppManager.uninstallAppCP(
			appName = "${appName}"
		);

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "App Manager"
		);

		AppManager.viewUninstallAppCP(
			appName = "${appName}"
		);
	}
}