@component-name = "portal-upgrades"
definition {
	property custom.properties = "organizations.types=organization,location";
	property portal.release = "true";
	property portal.upstream = "true";
	property ignore.errors = "Plugin security management is not enabled. Enable a security manager, then restart.";
	property testray.main.component.name = "Upgrades Foundation";

	setUp {
		SignIn.signIn();

		Smoke.viewWelcomePage();

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search"
		);

		SearchAdministration.executeSearchActions(
			actionsDescription = "Reindex all search indexes."
		);
	}

	@priority = "5"
	testAddOrganizationAfterUpgrade6012 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.0.12";

		Upgrade.addOrganization();
	}

	@priority = "5"
	testAddOrganizationAfterUpgrade612 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.1.2";

		Upgrade.addOrganization();
	}

	@priority = "5"
	testAddOrganizationAfterUpgrade6130 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.1.30";

		Upgrade.addOrganization();
	}

	@priority = "5"
	testAddOrganizationAfterUpgrade621015 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.2.10.15";

		Upgrade.addOrganization();
	}

	@priority = "5"
	testAddOrganizationAfterUpgrade623 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.2.3";

		Upgrade.addOrganization();
	}

	@priority = "5"
	testAddOrganizationAfterUpgrade625 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.2.5";

		Upgrade.addOrganization();
	}
}