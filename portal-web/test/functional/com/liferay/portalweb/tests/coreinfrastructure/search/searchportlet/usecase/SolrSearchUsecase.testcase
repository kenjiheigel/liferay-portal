	@priority = "5"
	testSearchUsingNewSitePagePortlets {
		property portal.acceptance = "true";
		var searchAssetType = "Web Content";
		var searchPage = "Search Page";
		var searchTerm = "Apple";

		ProductMenu.gotoSitesContent(
			portlet = "${searchAssetType}"
		);

		WebContentNavigator.gotoAddCP();

		WebContent.addCP(
			webContentContent = "WC WebContent Content",
			webContentTitle = "${searchTerm}"
		);

		PortletEntry.publish();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "${searchPage}"
		);

		for (portletName : "Type Facet,Search Results,Search Bar") {
			Navigator.gotoPage(
				pageName = "Search Page"
			);

			Portlet.addPG(
				portletName = "${portletName}"
			);
		}

		SearchBarPortlet.searchPG(
			searchTerm = "${searchTerm}"
		);

		SearchFacetPortlet.checkFacetOption(
			facetOption = "${searchAssetType}"
		);

		SearchFacetPortlet.assertSingleFacetURL(
			searchAssetType = "${searchAssetType}",
			searchPage = "${searchPage}",
			searchTerm = "${searchTerm}"
		);

		SearchResultPortlet.viewSearchResults(
			searchAssetTitle = "${searchTerm}",
			searchAssetType = "${searchAssetType}",
			searchTerm = "${searchTerm}"
		);
	}

	@priority = "4"
	testSearchXSSAsset {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Message Boards Page"
		);

		Navigator.gotoPage(
			pageName = "Message Boards Page"
		);

		Portlet.addPG(
			portletName = "Message Boards"
		);

		Navigator.gotoPage(
			pageName = "Message Boards Page"
		);

		MessageboardsThread.addPG(
			threadBody = '''<script>alert(123);</script>''',
			threadSubject = "Thread Subject"
		);

		SearchPortlet.searchPG(
			searchTerm = "Liferay Alert"
		);

		SearchPortlet.viewSearchResultPG(
			searchAssetTitle = "Thread Subject",
			searchAssetType = "Message Boards Message",
			searchAssetSummary = '''<script>alert(123);</script>'''
		);
		var actualScript = '''<script>alert(123);</script>''';
		var escapedScript = '''&lt;script&gt;<span class="highlight">alert</span>(123);&lt;/script&gt;''';

		AssertHTMLSourceTextNotPresent(value1 = "${actualScript}");

		AssertHTMLSourceTextPresent(value1 = "${escapedScript}");
	}

