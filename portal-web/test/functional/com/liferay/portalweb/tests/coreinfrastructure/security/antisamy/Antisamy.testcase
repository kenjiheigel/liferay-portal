@component-name = "portal-security"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Antisamy Hook";
	var pageName = "Antisamy Test Page";
	var portletName = "Wiki";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "${pageName}"
		);

		Navigator.gotoPage(
			pageName = "${pageName}"
		);

		Portlet.addPG(
			portletName = "${portletName}"
		);
	}

	tearDown {
		var testPortalInstance = "TestPropsUtil.get('test.portal.instance')";

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			WikiPage.tearDownCP();

			Page.tearDownCP();
		}
	}

	@priority = "4"
	testAddWikiFrontPageContentJavascript {
		var wikiPageContent = '''
				<p id='demo'>PASS</p>

				<script type='text/javascript'>
					document.getElementById('demo').innerHTML = 'FAIL';
				</script>
			''';
		var wikiPageText = "PASS";

		WikiPage.addFrontPagePG(
			htmlSource = "true",
			pageName = "${pageName}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageText = "${wikiPageText}"
		);
	}
}