@component-name = "portal-deployment-hypersonic"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property test.prepare.bundle.properties = "false";
	property setup.wizard.enabled = "true";
	property testray.component.names = "Training";
	property testray.main.component.name = "Setup Wizard";

	@priority = "4"
	testHSQLtoDB2 {
		property database.types = "db2";
		property test.name.skip.portal.instance = "SetupWizardHSQL#HSQLtoDB2";

		SetupWizard.configurePG(
			administratorEmail = "test@liferay.com",
			administratorFirstName = "Test",
			administratorLastName = "Test",
			databasePassword = "TestPropsUtil.get('database.db2.password')",
			databaseType = "DB2",
			databaseUserName = "TestPropsUtil.get('database.db2.username')",
			jdbcDriverClassName = "TestPropsUtil.get('database.db2.driver')",
			jdbcURL = "TestPropsUtil.get('database.db2.url')"
		);

		Smoke.viewWelcomePage(
			userFirstName = "Joe",
			userLastName = "Bloggs"
		);

		Smoke.runSmoke();
	}

	@priority = "4"
	testHSQLtoDB2SampleDataDisabled {
		property database.types = "db2";
		property test.name.skip.portal.instance = "SetupWizardHSQL#HSQLtoDB2SampleDataDisabled";

		SetupWizard.configurePG(
			addSampleData = "false",
			administratorEmail = "test@liferay.com",
			administratorFirstName = "Test",
			administratorLastName = "Test",
			databasePassword = "TestPropsUtil.get('database.db2.password')",
			databaseType = "DB2",
			databaseUserName = "TestPropsUtil.get('database.db2.username')",
			jdbcDriverClassName = "TestPropsUtil.get('database.db2.driver')",
			jdbcURL = "TestPropsUtil.get('database.db2.url')"
		);

		Smoke.viewWelcomePage();

		Smoke.runSmoke();
	}

