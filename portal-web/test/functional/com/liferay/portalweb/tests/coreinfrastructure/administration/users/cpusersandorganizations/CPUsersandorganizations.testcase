	@priority = "4"
	testViewOrganizationSiteViaSitesDirectory {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Sites Directory Page"
		);

		Navigator.gotoPage(
			pageName = "Sites Directory Page"
		);

		Portlet.addPG(
			portletName = "Sites Directory"
		);

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations"
		);

		Organization.addCP(
			orgName = "Organization Name 1",
			orgType = "Organization"
		);

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations"
		);

		UsersAndOrganizationsNavigator.gotoOrganizations();

		Organization.addSiteCP(
			orgName = "Organization Name 1"
		);

		ProductMenu.gotoSite(
			site = "Organization Name 1"
		);

		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Page"
		);

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations"
		);

		Organization.addCP(
			orgName = "Organization Name 2",
			orgType = "Organization"
		);

		Navigator.gotoPage(
			pageName = "Sites Directory Page"
		);

		var siteName = return(
			TestCase.getSiteName(
				siteName = "${siteName}"
			),
			siteName
		);
		var key_siteName = "${siteName}";
		var key_orgName = "Organization Name 1";

		AssertTextEquals.assertPartialText(locator1 = "SitesDirectory#SITE_ENTRY", value1 = "${siteName}");

		AssertTextEquals(locator1 = "SitesDirectory#ORG_SITE_ENTRY", value1 = "Organization Name 1");

		AssertElementNotPresent(locator1 = "SitesDirectory#ORG_SITE_ENTRY", key_orgName = "Organization Name 2");

		AssertClick(locator1 = "SitesDirectory#ORG_SITE_ENTRY", value1 = "Organization Name 1");

		Portlet.addPG(
			portletName = "Breadcrumb"
		);

		Navigator.gotoPage(
			pageName = "Sites Directory Page"
		);
		var key_orgName = "Organization Name 1";

		AssertClick(locator1 = "SitesDirectory#ORG_SITE_ENTRY", value1 = "Organization Name 1");

		Breadcrumb.viewPG(
			breadcrumbListNotVisible = "${siteName}",
			breadcrumbListVisible = "Organization Name 1",
			pathLocator = "CURRENT_LOCATION"
		);

		Breadcrumb.viewPG(
			breadcrumbListVisible = "Test Page",
			pathLocator = "PAGE"
		);
	}
