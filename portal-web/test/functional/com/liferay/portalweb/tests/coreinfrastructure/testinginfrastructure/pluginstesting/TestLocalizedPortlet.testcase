@component-name = "portal-test-plugins"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Test Plugins";
	property portlet.plugins.includes = "test-localized-portlet";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		Page.tearDownCP();
	}

	@priority = "4"
	testViewLocalizedChinese {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Localized Page"
		);

		Navigator.gotoPage(
			pageName = "Test Localized Page"
		);

		Portlet.addPG(
			portletName = "Test Localized Portlet"
		);

		AssertClick(locator1 = "TestLocalized#CHINESE_LOCALIZATION", value1 = "Chinese");

		AssertVisible(locator1 = "TestBlob#TEST_PORTLET_BODY_PASSED");

		AssertTextNotPresent(value1 = "FAILED");
	}

	@priority = "4"
	testViewLocalizedEnglish {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Localized Page"
		);

		Navigator.gotoPage(
			pageName = "Test Localized Page"
		);

		Portlet.addPG(
			portletName = "Test Localized Portlet"
		);

		AssertElementNotPresent(locator1 = "TestBlob#TEST_PORTLET_BODY_FAILED");

		AssertClick(locator1 = "TestLocalized#ENGLISH_LOCALIZATION", value1 = "English");

		AssertVisible(locator1 = "TestBlob#TEST_PORTLET_BODY_PASSED");

		AssertTextNotPresent(value1 = "FAILED");
	}

	@priority = "4"
	testViewLocalizedFrench {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Localized Page"
		);

		Navigator.gotoPage(
			pageName = "Test Localized Page"
		);

		Portlet.addPG(
			portletName = "Test Localized Portlet"
		);

		AssertClick(locator1 = "TestLocalized#FRENCH_LOCALIZATION", value1 = "French");

		AssertVisible(locator1 = "TestBlob#TEST_PORTLET_BODY_PASSED");

		AssertTextNotPresent(value1 = "FAILED");
	}

	@priority = "4"
	testViewLocalizedSpanish {
		ProductMenu.gotoPortlet(
			category = "Build",
			panel = "Site Administration",
			portlet = "Site Pages"
		);

		SitePages.addPublicPage(
			pageName = "Test Localized Page"
		);

		Navigator.gotoPage(
			pageName = "Test Localized Page"
		);

		Portlet.addPG(
			portletName = "Test Localized Portlet"
		);

		AssertClick(locator1 = "TestLocalized#SPANISH_LOCALIZATION", value1 = "Spanish");

		AssertVisible(locator1 = "TestBlob#TEST_PORTLET_BODY_PASSED");

		AssertTextNotPresent(value1 = "FAILED");
	}
}