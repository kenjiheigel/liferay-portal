@component-name = "portal-upgrades"
definition {
	property app.server.types = "jboss,resin,tcserver,tomcat,weblogic,websphere,wildfly";
	property database.types = "db2,mariadb,mysql,oracle,postgresql,sqlserver,sybase";
	property portal.release = "true";
	property portal.upstream = "true";
	property ignore.errors = "Plugin security management is not enabled. Enable a security manager, then restart.";
	property testray.main.component.name = "Upgrades Foundation";

	setUp {
		SignIn.signIn();

		Smoke.viewWelcomePage();

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Search"
		);

		SearchAdministration.executeSearchActions(
			actionsDescription = "Reindex all search indexes."
		);
	}

	@priority = "5"
	testViewPortalSmokeArchive6012 {
		property data.archive.type = "data-archive-portal";
		property portal.version = "6.0.12";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@priority = "5"
	testViewPortalSmokeArchive612 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "6.1.2";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@priority = "5"
	testViewPortalSmokeArchive6130 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "6.1.30";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@priority = "5"
	testViewPortalSmokeArchive621015 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "6.2.10.15";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@priority = "5"
	testViewPortalSmokeArchive623 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "6.2.3";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@priority = "5"
	testViewPortalSmokeArchive625 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "6.2.5";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@ignore = "true"
	@priority = "5"
	testViewPortalSmokeArchive70106 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "7.0.10.6";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}

	@ignore = "true"
	@priority = "5"
	testViewPortalSmokeArchive704 {
		property data.archive.type = "data-archive-portal";
		property portal.upgrades = "true";
		property portal.version = "7.0.4";
		property test.assert.warning.exceptions = "true";

		Upgrade.viewUpgrade();

		Upgrade.searchForAssetsAfterUpgrade();
	}
}