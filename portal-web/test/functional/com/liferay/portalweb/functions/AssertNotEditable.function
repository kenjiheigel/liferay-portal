@default = "assertNotEditable"
definition {
	function assertNotEditable {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.assertNotEditable();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertNotVisible {
		WaitForSPARefresh();

		selenium.assertNotEditable();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}