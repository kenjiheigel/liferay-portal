@default = "isElementPresent"
definition {
	function isElementPresent {
		WaitForSPARefresh();

		selenium.isElementPresent();
	}

	function isElementPresentAfterWait {
		WaitForSPARefresh();

		selenium.isElementPresentAfterWait();
	}

	function isElementPresentClickNavigation {
		WaitForSPARefresh();

		selenium.clickAt("//div[@id='navigationCollapse']");

		selenium.isElementPresent();
	}

	function isElementPresentCPNavigation {
		WaitForSPARefresh();

		selenium.waitForElementPresent("//script[contains(@src,'/liferay/message.js')]");

		IsElementPresent.isElementPresent();
	}

	function isVisible {
		WaitForSPARefresh();

		selenium.isVisible();
	}

	function pauseIsElementPresent {
		WaitForSPARefresh();

		selenium.pause("1000");

		selenium.isElementPresent();
	}

	function waitForVisible {
		WaitForSPARefresh();

		selenium.waitForVisible();

		IsElementPresent.isVisible();
	}
}