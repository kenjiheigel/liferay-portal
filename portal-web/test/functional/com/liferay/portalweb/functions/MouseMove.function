@default = "mouseMove"
definition {
	function mouseMove {
		WaitForSPARefresh();

		selenium.mouseMove();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseMoveAt {
		WaitForSPARefresh();

		selenium.mouseMoveAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}