@default = "assertTextEquals"
@summary = "Assert that '${locator1}' equals the value '${value1}'"
definition {
	function assertCKEditorText {
		WaitForSPARefresh();

		selenium.waitForVisible(
			"//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]"
		);

		selenium.pause("1000");

		selenium.selectFrame();

		selenium.waitForVisible("//html/body");

		selenium.assertText("//html/body");

		selenium.selectFrame("relative=parent");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	@summary = "Assert that '${locator1}' contains the value '${value1}'"
	function assertPartialText {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.waitForPartialText();

		selenium.assertPartialText();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertPartialTextAceEditor {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.waitForPartialTextAceEditor();

		selenium.assertPartialTextAceEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertText {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.waitForText();

		selenium.assertText();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertTextCaseInsensitive {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.waitForTextCaseInsensitive();

		selenium.assertTextCaseInsensitive();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertTextEquals {
		WaitForSPARefresh();

		if (contains("${locator1}", "/input")) {
			AssertTextEquals.assertValue();
		}
		else {
			AssertTextEquals.assertText();
		}
	}

	function assertTextWaitForCKEditor {
		WaitForSPARefresh();

		selenium.waitForVisible(
			"//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]"
		);

		AssertTextEquals.assertText();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertTextWaitForInlineCKEditor {
		WaitForSPARefresh();

		if (selenium.isElementPresent("//div[contains(@class,'cke_editable_inline')]")) {
			selenium.waitForElementPresent(
				"//script[contains(@src,'http://localhost:8080/o/frontend-editors-web/ckeditor/plugins/wsc/lang/en.js')]"
			);
		}

		AssertTextEquals.assertText();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertValue {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.waitForValue();

		selenium.assertValue();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}