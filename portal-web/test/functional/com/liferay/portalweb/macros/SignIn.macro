definition {
	var userEmailAddress = "test@liferay.com";
	var userPassword = "test";
	var userPasswordReminderAnswer = "test";

	macro _signIn {
		if (IsElementNotPresent(locator1 = "TextInput#EMAIL_ADDRESS")) {
			AssertClick(locator1 = "UserBar#USER_SIGN_IN", value1 = "Sign In");
		}

		Type(locator1 = "TextInput#EMAIL_ADDRESS", value1 = "${userEmailAddress}");

		Type(locator1 = "TextInput#PASSWORD", value1 = "${userPassword}");

		if ("${rememberMe}" == "true") {
			Check(locator1 = "Checkbox#REMEMBER_ME");
		}

		AssertClick(locator1 = "Button#SIGN_IN", value1 = "Sign In");

		AssertElementNotPresent(locator1 = "Button#SIGN_IN");
	}

	macro _signInByScreenName {
		Type(locator1 = "TextInput#SCREEN_NAME", value1 = "${userScreenName}");

		Type(locator1 = "TextInput#PASSWORD", value1 = "${userPassword}");

		if ("${rememberMe}" == "true") {
			Check(locator1 = "Checkbox#REMEMBER_ME");
		}

		AssertClick(locator1 = "Button#SIGN_IN", value1 = "Sign In");
	}

	@summary = "Agree to Liferay Portal Terms of Use"
	macro agreeToTermsOfUse {
		AssertClick(locator1 = "Button#I_AGREE", value1 = "I Agree");

		AssertElementNotPresent(locator1 = "Button#I_AGREE");
	}

	@summary = "Set '${userNewPassword}' as new user password"
	macro setNewPassword {
		Type(locator1 = "TextInput#NEW_PASSWORD", value1 = "${userNewPassword}");

		Type(locator1 = "TextInput#ENTER_AGAIN", value1 = "${userNewPassword}");

		Button.clickSave();

		AssertElementNotPresent(locator1 = "Button#SAVE");
	}

	@summary = "Enter '${userPasswordReminderAnswer}' as password reminder"
	macro setPasswordReminder {
		Type(locator1 = "TextInput#ANSWER", value1 = "${userPasswordReminderAnswer}");

		Button.clickSave();
	}

	@summary = "Sign in to Liferay Portal as '${userEmailAddress}' using the password '${userPassword}'"
	macro signIn {
		Navigator.openURL();

		SignIn._signIn(
			rememberMe = "${rememberMe}",
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}"
		);
	}

	macro signInByScreenName {
		Navigator.openURL();

		SignIn._signInByScreenName(
			rememberMe = "${rememberMe}",
			userEmailAddress = "${userScreenName}",
			userPassword = "${userPassword}",
			userScreenName = "${userScreenName}"
		);
	}

	@summary = "Sign in to Liferay Portal as '${userEmailAddress}' using the password '${userPassword}' for the first time"
	macro signInFirstTime {
		SignIn.signIn(
			rememberMe = "${rememberMe}",
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}"
		);

		SignIn.agreeToTermsOfUse();

		SignIn.setNewPassword(userNewPassword = "${userNewPassword}");

		SignIn.setPasswordReminder(
			userPasswordReminderAnswer = "${userPasswordReminderAnswer}",
			userReminderQueryAnswer = "${userReminderQueryAnswer}"
		);
	}

	macro signInPortalInstanceSetUp {
		SignIn.signInSpecificURL(url = "http://localhost:8080/");

		if (IsElementPresent(locator1 = "Button#I_AGREE")) {
			SignIn.agreeToTermsOfUse();
		}

		if (IsElementPresent(locator1 = "Select#QUESTION")) {
			SignIn.setPasswordReminder();
		}

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Virtual Instances"
		);

		while (IsElementPresent(locator1 = "ContentRow#ENTRY_CONTENT_ROW_NUMBER_ELLIPSIS", key_rowNumber = "2")) {
			Click.waitForMenuToggleJSClick(
				locator1 = "ContentRow#ENTRY_CONTENT_ROW_NUMBER_ELLIPSIS",
				key_rowNumber = "2"
			);

			MenuItem.clickNoError(menuItem = "Delete");

			Confirm(
				value1 = "Are you sure you want to delete this? It will be deleted immediately."
			);

			Alert.viewSuccessMessage();
		}

		var portalURL = PropsUtil.get('portal.url');
		var portalURL = StringUtil.replace('${portalURL}', 'http://', '');
		var portalURL = StringUtil.replace('${portalURL}', ':8080', '');

		LexiconEntry.gotoAdd();

		Type(locator1 = "TextInput#WEB_ID", value1 = "${portalURL}");

		Type(locator1 = "TextInput#VIRTUAL_HOST", value1 = "${portalURL}");

		Type(locator1 = "TextInput#MAIL_DOMAIN", value1 = "liferay.com");

		Button.clickSave();

		Alert.viewSuccessMessage();

		Navigator.openURL();
	}

	macro signInSite {
		Navigator.openSiteURL();

		SignIn._signIn(
			rememberMe = "${rememberMe}",
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}"
		);
	}

	macro signInSpecificURL {
		Navigator.openSpecificURL(url = "${url}");

		SignIn._signIn(
			rememberMe = "${rememberMe}",
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}"
		);
	}

	@summary = "Sign in to Liferay Portal as '${userEmailAddress}' using the password '${userPassword}'"
	macro signInTestSetup {
		SignOut.signOut();

		SignIn.signIn();

		if (IsElementPresent(locator1 = "Button#I_AGREE")) {
			SignIn.agreeToTermsOfUse();
		}

		if (IsElementPresent(locator1 = "Select#QUESTION")) {
			SignIn.setPasswordReminder();
		}
	}

	macro viewSignInError {
		if (isSet(nodePort)) {
			Navigator.openSpecificURL(url = "http://localhost:${nodePort}");
		}
		else if (isSet(specificURL)) {
			Navigator.openSpecificURL(url = "${specificURL}");
		}
		else {
			Navigator.openURL();
		}

		SignIn._signIn(
			rememberMe = "${rememberMe}",
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}"
		);

		if ("${error}" == "internalServerError") {
			AssertTextEquals(
				locator1 = "Home#ERROR_MESSAGE_ALERT_ERROR",
				value1 = "Internal Server Error"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "Message#URL_ERROR",
				value1 = "${urlErrorMessage}"
			);
		}
	}
}