definition {
	macro _gotoAddCollection {
		if (IsElementPresent(locator1 = "NavNested#NAV_NESTED_PLUS")) {
			Click(locator1 = "NavNested#NAV_NESTED_PLUS");
		}
		else {
			Button.click(button = "New");
		}
	}

	macro _gotoTab {
		AssertClick(
			locator1 = "Fragment#FRAGMENT_SIDEBAR_TAB",
			value1 = "${tabName}",
			key_tabName = "${tabName}"
		);
	}

	macro add {
		LexiconEntry.gotoAddMenuItem(menuItem = "Content Page Template");

		PortletEntry.inputName(name = "${pageTemplateName}");

		Button.clickSave();
	}

	macro addCollection {
		LayoutPageTemplates._gotoAddCollection();

		Collection.editCollection(
			collectionDescription = "${collectionDescription}",
			collectionName = "${collectionName}"
		);

		Button.clickSave();
	}

	macro editFragmentImage {
		MouseOver.mouseOverNotVisible(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_HEADER",
			key_fragmentName = "${fragmentName}"
		);

		Click(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_HEADER",
			key_fragmentName = "${fragmentName}"
		);

		SelectFrame(locator1 = "IFrame#DIALOG");

		AssertClick(locator1 = "Button#SELECT_FILE", value1 = "Select File");

		SikuliClick(locator1 = "OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG");

		SikuliUploadCommonFile(
			locator1 = "OS#FILE_DIALOG_BOX_FILE_NAME_FIELD_PNG",
			value1 = "${fileName}"
		);

		SelectFrameTop();

		Click(locator1 = "Button#ADD");
	}

	macro editFragmentText {
		MouseOver.mouseOverNotVisible(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_EDITABLE_TEXT",
			key_fragmentName = "${fragmentName}",
			key_id = "${id}"
		);

		Click(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_EDITABLE_TEXT",
			key_fragmentName = "${fragmentName}",
			key_id = "${id}"
		);

		if (IsElementPresent(locator1 = "Button#EDIT")) {
			Button.clickEdit();
		}

		Type(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_EDITABLE_TEXT_CK_EDITOR",
			value1 = "${text}",
			key_fragmentName = "${fragmentName}",
			key_id = "${id}"
		);
	}

	macro expandFragmentCollection {
		if (IsElementPresent(locator1 = "Fragment#FRAGMENT_SIDEBAR_COLLECTION_PANEL_COLLAPSED", key_collectionName = "${collectionName}")) {
			AssertClick(
				locator1 = "Fragment#FRAGMENT_SIDEBAR_COLLECTION_PANEL_COLLAPSED",
				value1 = "${collectionName}",
				key_collectionName = "${collectionName}"
			);
		}

		AssertElementPresent(
			locator1 = "Fragment#FRAGMENT_SIDEBAR_COLLECTION_PANEL_EXPANDED",
			key_collectionName = "${collectionName}"
		);
	}

	macro gotoPortletConfiguration {
		MouseOver(
			locator1 = "Fragment#PAGE_TEMPLATE_NAVIGATION_PORTLET",
			key_fragmentName = "${fragmentName}"
		);

		Click(
			locator1 = "Fragment#PAGE_TEMPLATE_PORTLET_CONFIGURE",
			key_fragmentName = "${fragmentName}"
		);
	}

	macro moveFragment {
		if ("${direction}" == "up") {
			Click.clickNoWaitForVisible(
				locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_UP_ARROW_BUTTON",
				key_fragmentName = "${fragmentName}"
			);
		}
		else if ("${direction}" == "down") {
			Click.clickNoWaitForVisible(
				locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_DOWN_ARROW_BUTTON",
				key_fragmentName = "${fragmentName}"
			);
		}
	}

	macro removeFragment {
		MouseOver.mouseOverNotVisible(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_HEADER",
			key_fragmentName = "${fragmentName}"
		);

		Click(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_DELETE_BUTTON",
			key_fragmentName = "${fragmentName}"
		);
	}

	macro rename {
		LexiconEntry.gotoEntryMenuItem(menuItem = "Rename", rowEntry = "${rowEntry}");

		PortletEntry.inputName(name = "${pageTemplateName}");

		Modal.save();
	}

	macro selectFragment {
		LayoutPageTemplates._gotoTab(tabName = "Available");

		LayoutPageTemplates.expandFragmentCollection(
			collectionName = "${collectionName}"
		);

		Click(
			locator1 = "Fragment#FRAGMENT_SIDEBAR_FRAGMENT",
			key_collectionName = "${collectionName}",
			key_fragmentName = "${fragmentName}"
		);

		AssertElementPresent(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_HEADER",
			key_fragmentName = "${fragmentName}"
		);
	}

	macro viewAutoSaveMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "Fragment#PAGE_TEMPLATE_AUTOSAVE_MESSAGE",
			value1 = "Changes saved at"
		);
	}

	macro viewCollectionNotPresent {
		AssertElementNotPresent(
			locator1 = "Fragment#FRAGMENT_SIDEBAR_COLLECTION_PANEL",
			key_collectionName = "${collectionName}"
		);
	}

	macro viewEditorEmpty {
		AssertElementPresent(locator1 = "Fragment#PAGE_TEMPLATE_EMPTY_MESSAGE");
	}

	macro viewFragment {
		AssertElementPresent(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_HEADER",
			key_fragmentName = "${fragmentName}"
		);
	}

	macro viewFragmentEditableText {
		AssertTextEquals(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_EDITABLE_TEXT",
			value1 = "${editableText}",
			key_fragmentName = "${fragmentName}",
			key_id = "${id}"
		);
	}

	macro viewFragmentOrder {
		AssertElementPresent(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_HEADER_POSITION",
			key_fragmentName = "${fragmentName}",
			key_position = "${position}"
		);
	}

	macro viewNavigationPortlet {
		if (contains("${displayTemplateClass}", "{displayTemplateClass}")) {
			var displayTemplateClass = "navbar-blank";
		}

		AssertElementPresent(
			locator1 = "Fragment#PAGE_TEMPLATE_NAVIGATION_PORTLET",
			key_fragmentName = "${fragmentName}"
		);

		AssertElementPresent(
			locator1 = "Fragment#PAGE_TEMPLATE_NAVIGATION_PORTLET_DISPLAY_CLASS",
			key_displayTemplateClass = "${displayTemplateClass}",
			key_fragmentName = "${fragmentName}"
		);
	}
}