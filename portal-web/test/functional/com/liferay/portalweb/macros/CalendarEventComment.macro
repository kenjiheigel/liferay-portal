definition {
	var siteName = "Liferay";

	macro add {
		if ("${calendarType}" == "My Calendars") {
			Click(locator1 = "Calendar#MY_CALENDARS_MENULIST_ARROW");

			AssertClick(
				locator1 = "Calendar#MY_CALENDARS_MENULIST_ADD_CALENDAR",
				value1 = "Add Calendar"
			);

			Type.type(locator1 = "TextInput#NAME", value1 = "${calendarName}");

			Button.clickSave();

			Click(locator1 = "Button#SAVE");

			Alert.viewSuccessMessage();
		}
		else if ("${calendarType}" == "Current Site Calendars") {
			var key_siteName = "${siteName}";

			Click(locator1 = "Calendar#CURRENT_SITE_CALENDARS_MENULIST_ARROW");

			AssertClick(
				locator1 = "Calendar#CURRENT_SITE_CALENDARS_MENULIST_ADD_CALENDAR",
				value1 = "Add Calendar"
			);

			Type.type(locator1 = "TextInput#NAME", value1 = "${calendarName}");

			Button.clickSave();

			Click(locator1 = "Button#SAVE");

			Alert.viewSuccessMessage();
		}
		else if ("${calendarType}" == "Other Calendars") {
			Type(locator1 = "Calendar#OTHER_CALENDARS_SEARCH", value1 = "${calendarName}");

			var key_calendarName = "${calendarName}";

			AssertClick(
				locator1 = "Calendar#OTHER_CALENDARS_SEARCH_LIST_RESULT",
				value1 = "${calendarName}"
			);

			AssertTextEquals(
				locator1 = "Calendar#OTHER_CALENDARS_CALENDAR",
				value1 = "${calendarName}"
			);
		}
	}

	macro delete {
		CalendarNavigator.gotoView(viewType = "Week");

		var key_calendarName = "${calendarName}";
		var key_user = "${user}";

		AssertTextEquals(
			locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL",
			value1 = "${calendarName}"
		);

		Click(locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL_MENULIST_ARROW");

		Calendar._deleteCalendar();

		AssertElementNotPresent(locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL");

		AssertTextNotPresent(value1 = "${calendarName}");
	}

	macro tearDown {
		CalendarNavigator.gotoView(viewType = "Week");

		while (IsElementPresent(locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL_GENERIC")) {
			Click(
				locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL_GENERIC_MENULIST_ARROW"
			);

			Calendar._deleteCalendar();
		}

		while (IsElementPresent(locator1 = "Calendar#CURRENT_SITE_CALENDARS_CALENDAR_ADDITIONAL_GENERIC")) {
			Click(
				locator1 = "Calendar#CURRENT_SITE_CALENDARS_CALENDAR_ADDITIONAL_GENERIC_MENULIST_ARROW"
			);

			Calendar._deleteCalendar();
		}

		while (IsElementPresent(locator1 = "Calendar#OTHER_CALENDARS_CALENDAR_GENERIC")) {
			Calendar.chooseOtherCalendarMenulistOption(
				calendarName = "${calendarName}",
				menuListOption = "Hide Calendar"
			);
		}

		AssertElementNotPresent(
			locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL_GENERIC"
		);

		AssertElementNotPresent(
			locator1 = "Calendar#CURRENT_SITE_CALENDARS_CALENDAR_ADDITIONAL_GENERIC"
		);

		AssertElementNotPresent(locator1 = "Calendar#OTHER_CALENDARS_CALENDAR_GENERIC");
	}

	macro view {
		var key_calendarName = "${calendarName}";

		if ("${calendarType}" == "My Calendars") {
			var key_user = "${user}";

			AssertTextEquals(
				locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL",
				value1 = "${calendarName}"
			);
		}
		else if ("${calendarType}" == "Current Site Calendars") {
			var key_site = "${site}";

			AssertTextEquals(
				locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL",
				value1 = "${calendarName}"
			);
		}
		else if ("${calendarType}" == "Other Calendars") {
			Type(locator1 = "Calendar#OTHER_CALENDARS_SEARCH", value1 = "${calendarName}");

			var key_calendarName = "${calendarName}";

			AssertClick(
				locator1 = "Calendar#OTHER_CALENDARS_SEARCH_LIST_RESULT",
				value1 = "${calendarName}"
			);

			AssertTextEquals(
				locator1 = "Calendar#OTHER_CALENDARS_CALENDAR",
				value1 = "${calendarName}"
			);
		}
	}

	macro viewDefault {
		var key_calendarName = "${calendarName}";
		var key_user = "${user}";

		AssertElementNotPresent(locator1 = "Calendar#MY_CALENDARS_CALENDAR_ADDITIONAL");

		AssertTextNotPresent(value1 = "${calendarName}");
	}
}