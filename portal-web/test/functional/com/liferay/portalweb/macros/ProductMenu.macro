definition {
	@summary = "Navigate to Product Menu > Control Panel > Apps > ${portlet}"
	macro gotoControlPanelApps {
		ProductMenuHelper.expandPanel(panel = "Control Panel");

		ProductMenuHelper.expandCategory(category = "Apps");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Control Panel > Configuration > ${portlet}"
	macro gotoControlPanelConfiguration {
		ProductMenuHelper.expandPanel(panel = "Control Panel");

		ProductMenuHelper.expandCategory(category = "Configuration");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Control Panel > Sites > ${portlet}"
	macro gotoControlPanelSites {
		ProductMenuHelper.expandPanel(panel = "Control Panel");

		ProductMenuHelper.expandCategory(category = "Sites");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Control Panel > Users > ${portlet}"
	macro gotoControlPanelUsers {
		ProductMenuHelper.expandPanel(panel = "Control Panel");

		ProductMenuHelper.expandCategory(category = "Users");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to the Live site"
	macro gotoLiveSite {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		AssertClick(locator1 = "ProductMenu#LIVE_LINK", value1 = "Live");
	}

	@summary = "Navigate to Product Menu > Control Panel > ${category} > ${portlet}"
	macro gotoLocalizedControlPanel {
		ProductMenuHelper.expandPanel(panel = "Control Panel");

		ProductMenuHelper.expandCategory(category = "${category}");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Navigate to Product Menu > Sites > ${category} > ${page}"
	macro gotoLocalizedEditPage {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "${category}");

		var key_page = "${page}";

		Click.mouseOverClick(locator1 = "SitePages#SPECIFIC_PAGE_ELLIPSIS");

		Click(locator1 = "SitePages#EDIT_SPECIFIC_PAGE");
	}

	@summary = "Navigate to Product Menu > Sites > Sites Modal > ${site}"
	macro gotoLocalizedSite {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.openSitesPopup();

		SelectFrame(locator1 = "IFrame#DIALOG");

		Navigator.gotoNavItem(navItem = "${navItem}");

		LexiconEntry.changeDisplayStyle(displayStyle = "${displayStyle}");

		SiteSelector._searchSite(site = "${site}");

		LexiconEntry.gotoEntry(rowEntry = "${site}");

		SelectFrameTop();

		ProductMenuHelper.expandPanel(panel = "Site Administration");

		AssertTextEquals.assertPartialText(
			locator1 = "ProductMenu#PRODUCT_MENU_PANEL_SITE_ADMINISTRATION_SITE_NAME",
			value1 = "${site}"
		);
	}

	@summary = "Navigate to Product Menu > Sites > ${category} > ${portlet}"
	macro gotoLocalizedSitesAdministration {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "${category}");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > User > My Account > ${portlet}"
	macro gotoLocalizedUserMyAccount {
		ProductMenuHelper.expandPanel(panel = "User");

		ProductMenuHelper.expandCategory(category = "${category}");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Profile"
	macro gotoPersonalSite {
		ProductMenuHelper.expandPanel(panel = "User");

		Click(locator1 = "ProductMenu#USER_PROFILE");
	}

	@summary = "Navigate to Product Menu > ${panel} > ${category} > ${portlet}"
	macro gotoPortlet {
		ProductMenuHelper.expandPanel(panel = "${panel}");

		ProductMenuHelper.expandCategory(category = "${category}");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Sites > Site Popup > ${site}"
	macro gotoPublicSite {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.openSitesPopup();

		var key_site = "${site}";

		AssertClick(locator1 = "ProductMenu#PUBLIC_SITE_LINK", value1 = "${site}");
	}

	@summary = "Navigate to Product Menu > Sites > Sites Modal > ${site}"
	macro gotoSite {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.openSitesPopup();

		SelectFrame(locator1 = "IFrame#DIALOG");

		Navigator.gotoNavItem(navItem = "My Sites");

		SiteSelector.selectSite(site = "${site}");

		ProductMenuHelper.expandPanel(panel = "Site Administration");

		AssertTextEquals.assertPartialText(
			locator1 = "ProductMenu#PRODUCT_MENU_PANEL_SITE_ADMINISTRATION_SITE_NAME",
			value1 = "${site}"
		);
	}

	@summary = "Navigate to Product Menu > Sites > Commerce > ${portlet}"
	macro gotoSitesCommerce {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "Commerce");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Sites > Configuration > ${portlet}"
	macro gotoSitesConfiguration {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "Configuration");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Sites > Content > ${portlet}"
	macro gotoSitesContent {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "Content");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Sites > Members > ${portlet}"
	macro gotoSitesMembers {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "Members");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Sites > Publishing > ${portlet}"
	macro gotoSitesPublishing {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		ProductMenuHelper.expandCategory(category = "Publishing");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "Navigate to ${site} via the 'Go to Site' link"
	macro gotoSiteViaLink {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		AssertClick(locator1 = "ProductMenu#GO_TO_SITES_LINK", value1 = "Go to Site");
	}

	@summary = "Navigate to the Staging site"
	macro gotoStagingSite {
		if (IsElementNotPresent(locator1 = "ProductMenu#STAGING_SELECTED")) {
			ProductMenuHelper.expandPanel(panel = "Site Administration");

			AssertClick(locator1 = "ProductMenu#STAGING_LINK", value1 = "Staging");
		}

		AssertVisible(locator1 = "ProductMenu#STAGING_SELECTED");
	}

	@summary = "Navigate to Product Menu > User > My Account > ${portlet}"
	macro gotoUserMyAccount {
		ProductMenuHelper.expandPanel(panel = "User");

		ProductMenuHelper.expandCategory(category = "My Account");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

	@summary = "View ${site} is not available in the product menu."
	macro viewNoSite {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		if ((IsElementPresent(locator1 = "ProductMenu#BACK_ARROW")) && (IsVisible(locator1 = "ProductMenu#BACK_ARROW"))) {
			Click(locator1 = "ProductMenu#BACK_ARROW");
		}

		ProductMenuHelper.viewNoSite(site = "${site}");
	}

	@summary = "View ${site} is available in the product menu."
	macro viewSite {
		ProductMenuHelper.expandPanel(panel = "Site Administration");

		if ((IsElementPresent(locator1 = "ProductMenu#SITES_POPUP")) && (IsNotVisible(locator1 = "ProductMenu#SITES_POPUP"))) {
			Click(locator1 = "ProductMenu#SITES_COMPASS");

			AssertVisible(locator1 = "ProductMenu#SITES_POPUP");
		}

		ProductMenuHelper.viewSite(site = "${site}");
	}
}