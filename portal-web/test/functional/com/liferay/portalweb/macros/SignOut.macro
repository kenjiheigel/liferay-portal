definition {
	@summary = "Sign out of Liferay Portal"
	macro signOut {
		Navigator.openURL();

		UserBar.signOut();
	}

	macro signOutOfSite {
		Navigator.openSiteURL(siteName = "${siteName}", siteNameURL = "${siteNameURL}");

		UserBar.signOut();
	}

	macro signOutOfSpecificURL {
		Navigator.openSpecificURL(url = "${url}");

		UserBar.signOut();
	}
}