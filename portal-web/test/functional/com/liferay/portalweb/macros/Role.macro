	}

	macro removeStagingAdminRole {
		var roleTitle = "Staging Admin";

		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles"
		);

		RoleNavigator.gotoRoleType(roleType = "Site");

		Search.searchCP(searchTerm = "${roleTitle}");

		var key_itemName = "${roleTitle}";

		if (IsElementPresent.pauseIsElementPresent(locator1 = "ListGroupItem#ITEM_NAME")) {
			LexiconEntry.delete(rowEntry = "${roleTitle}");
		}
	}

	macro tearDownCP {
		ProductMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles"
		);

		Search.searchCP(searchTerm = "Name");

		while (IsElementPresent.pauseIsElementPresent(locator1 = "ListGroupItem#ITEM_ACTIONS_DEFAULT")) {
			Click(locator1 = "ListGroupItem#ITEM_ACTIONS_DEFAULT");

			MenuItem.clickNoError(menuItem = "Delete");

			Confirm(
				value1 = "Are you sure you want to delete this? It will be deleted immediately."
			);
		}
	}

	macro unassignMembersOrganizationsCP {
		Search.searchCP(searchTerm = "${roleTitle}");

		var key_itemName = "${roleTitle}";

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Assign Members",
			rowEntry = "${roleTitle}"
		);

		AssertClick(locator1 = "NavTab#ORGANIZATIONS", value1 = "Organizations");

		var key_orgName = "${orgName}";

		AssertClick(locator1 = "NavTab#CURRENT", value1 = "Current");

		Search.searchCP(searchTerm = "${orgName}");

		AssertTextEquals(
			locator1 = "RolesAssignMembers#ORGANIZATION_TABLE_NAME",
			value1 = "${orgName}"
		);

		Uncheck(locator1 = "RolesAssignMembers#ORGANIZATION_TABLE_CHECKBOX");

		AssertClick(
			locator1 = "Button#UPDATE_ASSOCIATIONS",
			value1 = "Update Associations"
		);

		Alert.viewSuccessMessage();
	}

