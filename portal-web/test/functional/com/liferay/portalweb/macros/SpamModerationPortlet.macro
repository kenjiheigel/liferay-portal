definition {
	macro MarkAsNotSpam {
		if ("${assetType}" == "wikiPage") {
			var key_wikiPageTitle = "${wikiPageTitle}";

			Check(locator1 = "SpamModeration#WIKI_PAGE_TABLE_CHECKBOX");

			AssertClickNoError(
				locator1 = "SpamModeration#WIKIS_NOT_SPAM_BUTTON",
				value1 = "Not Spam"
			);

			Confirm(value1 = "Are you sure you want to mark the selected pages not spam?");

			AssertElementPresent(locator1 = "Message#SUCCESS");
		}
	}

	macro MarkAsSpam {
		if ("${assetType}" == "wikiPage") {
			var key_wikiPageTitle = "${wikiPageTitle}";

			Check(locator1 = "SpamModeration#WIKI_PAGE_TABLE_CHECKBOX");

			AssertClickNoError(
				locator1 = "SpamModeration#WIKIS_SPAM_BUTTON",
				value1 = "Spam"
			);

			Confirm(value1 = "Are you sure you want to mark the selected pages as spam?");

			AssertElementPresent(locator1 = "Message#SUCCESS");
		}
	}

	macro navigateToDiscussions {
		AssertClick(
			locator1 = "SpamModeration#NAVIGATION_DISCUSSIONS",
			value1 = "Wikis"
		);
	}

	macro navigateToMessageBoards {
		AssertClick(
			locator1 = "SpamModeration#NAVIGATION_MESSAGE_BOARDS",
			value1 = "Wikis"
		);
	}

	macro navigateToWikis {
		AssertClick(locator1 = "SpamModeration#NAVIGATION_WIKIS", value1 = "Wikis");
	}

	macro viewDefault {
		if ("${assetType}" == "wikiPage") {
			AssertTextEquals(locator1 = "Message#INFO", value1 = "There are no pages. ");
		}
	}

	macro viewMarkedAsSpam {
		if ("${assetType}" == "wikiPage") {
			var key_wikiPageTitle = "${wikiPageTitle}";

			AssertElementPresent(locator1 = "SpamModeration#WIKI_PAGE_TABLE_CHECKBOX");

			AssertTextEquals(
				locator1 = "SpamModeration#WIKI_PAGE_TABLE_TITLE",
				value1 = "${wikiPageTitle}"
			);

			AssertTextEquals(
				locator1 = "SpamModeration#WIKI_PAGE_TABLE_VERSION",
				value1 = "${wikiPageRevision}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "SpamModeration#WIKI_PAGE_TABLE_POSTED_BY",
				value1 = "${wikiPageUsername}"
			);

			AssertElementPresent(locator1 = "SpamModeration#WIKI_PAGE_TABLE_ACTIONS");
		}
	}
}