definition {

	macro _addFragment {
		var groupId = JSONGroup.getGroupIdByName(groupName = "${groupName}");

		var portalURL = JSONCompany.getPortalURL();

		var collectionId = JSONFragment.getCollectionIdByName(
			collectionName = "${collectionName}",
			groupId = "${groupId}"
		);

		if (!(isSet(collectionId))) {
			fail("Please set 'collectionId'.");
		}

		var curl = '''
			${portalURL}/api/jsonws/fragment.fragmententry/add-fragment-entry \
			-u test@liferay.com:test \
			-d groupId=${groupId} \
			-d fragmentCollectionId=${collectionId} \
			-d name=${name} \
			-d status=${status}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post('${curl}');
	}

	macro _addFragmentCollection {
		var portalURL = JSONCompany.getPortalURL();

		var groupId = JSONGroup.getGroupIdByName(groupName = "${groupName}");

		if (!(isSet(groupId))) {
			fail("Please set 'groupId'.");
		}

		var curl = '''
			${portalURL}/api/jsonws/fragment.fragmentcollection/add-fragment-collection \
			-u test@liferay.com:test \
			-d groupId=${groupId} \
			-d name=${name} \
			-d description=
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post('${curl}');
	}

	macro addFragment {
		if (!(isSet(name))) {
			fail("Please set 'name'.");
		}

		if (!(isSet(collectionName))) {
			fail("Please set 'collectionName'.");
		}

		if (!(isSet(status))) {
			var status = "0";
		}

		JSONFragment._addFragment(
			collectionName = "${collectionName}",
			fragmentFile = "${fragmentFile}",
			groupName = "${groupName}",
			name = "${name}",
			status = "${status}"
		);
	}

	macro addFragmentCollection {
		if (!(isSet(name))) {
			fail("Please set 'name'.");
		}

		if (!(isSet(groupName))) {
			fail("Please set 'groupName'.");
		}

		JSONFragment._addFragmentCollection(
			groupName = "${groupName}",
			name = "${name}"
		);
	}

	macro getCollectionIdByName {
		var portalURL = JSONCompany.getPortalURL();

		if (!(isSet(collectionName))) {
			fail("Please set 'collectionName'.");
		}

		if (!(isSet(groupId))) {
			fail("Please set 'groupId'.");
		}

		var curl = '''
			${portalURL}/api/jsonws/fragment.fragmentcollection/get-fragment-collections \
			-u test@liferay.com:test \
			-d groupId=${groupId} \
			-d name=${collectionName} \
			-d <CURL_DATA[start=-1]CURL_DATA> \
			-d <CURL_DATA[end=-1]CURL_DATA> \
			-d -orderByComparator=
		''';
		var collectionId = JSONCurlUtil.post('${curl}', '$..fragmentCollectionId');
		var collectionId = StringUtil.replace('${collectionId}', '["', '');
		var collectionId = StringUtil.replace('${collectionId}', '"]', '');

		return "${collectionId}";
	}
}