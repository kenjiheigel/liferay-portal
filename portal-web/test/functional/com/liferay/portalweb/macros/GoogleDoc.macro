definition {
	macro edit {
		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(
			locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_VERTICAL_ELLIPSIS"
		);

		MenuItem.click(menuItem = "Edit in Google Docs");

		Type(locator1 = "GoogleDoc#TITLE", value1 = "${dmDocumentTitleEdit}");

		AssertClick(
			locator1 = "Button#ANY",
			value1 = "Save and Return to Liferay",
			key_text = "Save and Return to Liferay"
		);
	}
}