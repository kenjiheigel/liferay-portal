definition {
	macro addCategorization {
		if (IsVisible(locator1 = "AssetCategorization#CATEGORIZATION_PANEL_COLLAPSED")) {
			AssertClick(
				locator1 = "AssetCategorization#CATEGORIZATION_PANEL_EXPANDED",
				value1 = "Categorization"
			);
		}

		Type(locator1 = "AssetCategorization#TAGS_FIELD", value1 = "${tagName}");

		AssertClick(locator1 = "AssetCategorization#TAGS_ADD_BUTTON", value1 = "Add");

		var key_tagName = "${tagName}";

		AssertTextEquals(locator1 = "AssetCategorization#TAG", value1 = "${tagName}");
	}

	macro gotoDrive {
		AssertClick(locator1 = "Button#SELECT_FILE", value1 = "Select File");

		Pause(locator1 = "3000");

		if (isSet(windowTitle)) {
			SelectWindow(locator1 = "GoogleLogin#PAGE_TITLE");

			if (IsElementPresent(locator1 = "GoogleLogin#HEADER")) {
				AssertClick(
					locator1 = "GoogleLogin#ACCOUNT_MENULIST_USE_ANOTHER_ACCOUNT",
					value1 = "Use another account"
				);
			}

			Type(locator1 = "GoogleLogin#LOGIN_EMAIL_FIELD", value1 = "${userEmailAddress}");

			Click(locator1 = "GoogleLogin#LOGIN_NEXT_BUTTON");

			AssertElementPresent(locator1 = "GoogleLogin#LOGIN_NEXT_BUTTON");

			Type(locator1 = "GoogleLogin#LOGIN_PASSWORD_FIELD", value1 = "${userPassword}");

			Click(locator1 = "GoogleLogin#LOGIN_NEXT_BUTTON");

			SelectWindow.selectWindowNoSPARefresh(locator1 = "title=${windowTitle}");

			Pause(locator1 = "3000");
		}

		if (IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) {
			Click.clickNoSPARefresh(locator1 = "ProductMenu#TOGGLE");
		}

		SelectFrame(locator1 = "GoogleDrive#GOOGLE_DRIVE_IFRAME");
	}

	macro selectDocument {
		var key_googleDocName = "${googleDocName}";

		Click.clickAt(
			locator1 = "GoogleDrive#LIST_VIEW_DOCUMENT",
			value1 = "${googleDocName}"
		);

		Click.clickAt(locator1 = "GoogleDrive#SELECT_BUTTON", value1 = "Select");

		SelectFrameTop();

		var key_dmDocumentTitle = "${googleDocName}";

		AssertTextEquals(
			locator1 = "DocumentsAndMediaEntry#SELECTED_DOCUMENT_TITLE",
			value1 = "${googleDocName}"
		);
	}

	macro selectRelatedAsset {
		if (IsElementNotPresent(locator1 = "AssetRelatedAssets#RELATED_ASSETS_SELECT")) {
			Click(locator1 = "AssetRelatedAssets#HEADER_COLLAPSED");

			AssertElementPresent(locator1 = "AssetRelatedAssets#HEADER_EXPANDED");
		}

		AssertClick(locator1 = "Button#SELECT", value1 = "Select");

		var key_assetType = "${assetType}";

		AssertClick(
			locator1 = "AssetRelatedAssets#RELATED_ASSETS_SELECT_MENULIST_ASSET",
			value1 = "${assetType}"
		);

		SelectFrame(locator1 = "AssetRelatedAssets#SELECT_ASSET_IFRAME");

		var key_assetTitle = "${assetTitle}";

		AssertClick(
			locator1 = "AssetRelatedAssets#ASSET_TABLE_CHOOSE",
			value1 = "Choose"
		);

		SelectFrame(value1 = "relative=top");
	}
}