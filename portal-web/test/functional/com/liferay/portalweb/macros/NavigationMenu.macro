definition {
	macro gotoAddPage {
		Portlet.clickPortletPlusIconPG(portletName = "Navigation Menu");

		MenuItem.click(menuItem = "Add Page");
	}

	macro selectAndSaveConfiguration {
		SelectFrame(locator1 = "IFrame#CONFIGURATION");

		Select(locator1 = "Select#DISPLAY_TEMPLATE", value1 = "${displayTemplate}");

		PortletEntry.save();

		IFrame.closeFrame();
	}
}