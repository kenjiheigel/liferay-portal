definition {
	macro add {
		LexiconEntry.gotoAdd();

		PortletEntry.inputName(name = "${displayPageName}");

		Button.clickSave();
	}

	macro assertAssetTypeUnselectable {
		LayoutPageTemplates._gotoTab(tabName = "Mapping");

		Button.viewNotPresent(button = "Select");
	}

	macro mapEditableTextToAsset {
		LayoutPageTemplates._gotoTab(tabName = "Mapping");

		MouseOver.mouseOverNotVisible(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_EDITABLE_TEXT",
			key_fragmentName = "${fragmentName}",
			key_id = "${id}"
		);

		Click(
			locator1 = "Fragment#PAGE_TEMPLATE_FRAGMENT_EDITABLE_TEXT",
			key_fragmentName = "${fragmentName}",
			key_id = "${id}"
		);

		Button.clickMap();

		AssertClick(
			locator1 = "Fragment#LIST_GROUP_ITEM",
			value1 = "${itemName}",
			key_itemName = "${itemName}"
		);
	}

	macro selectAssetType {
		LayoutPageTemplates._gotoTab(tabName = "Mapping");

		Button.clickSelect();

		if (contains("${assetType}", "{assetType}")) {
			var assetType = "Web Content Article";

			if (contains("${subType}", "{subType}")) {
				var subType = "Basic Web Content";
			}
		}

		Select(
			locator1 = "Select#GENERIC_SELECT_FIELD",
			value1 = "${assetType}",
			key_fieldLabel = "Asset Type"
		);

		Select(
			locator1 = "Select#GENERIC_SELECT_FIELD",
			value1 = "${subType}",
			key_fieldLabel = "Subtype"
		);

		Button.clickSave();
	}

	macro viewPGViaAP {
		var key_assetContent = "${webContentContent}";
		var key_assetTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "AP#ASSET_ABSTRACT_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "AP#ASSET_ABSTRACT_DESCRIPTION",
			value1 = "${webContentContent}"
		);

		AssertClick(locator1 = "AP#ASSET_ABSTRACT_TITLE", value1 = "${webContentTitle}");

		for (var content : list "${contentList}") {
			AssertElementPresent(
				locator1 = "Fragment#EDITABLE_FIELD_CONTENT",
				key_text = "${content}"
			);
		}
	}

	macro viewPGViaFriendlyURL {
		var portalURL = PropsUtil.get('portal.url');
		var siteNameURL = StringUtil.toLowerCase('${siteName}');
		var siteNameURL = StringUtil.replace('${siteNameURL}', ' ', '-');

		Navigator.openSpecificURL(
			url = "${portalURL}/web/${siteNameURL}/-/${friendlyURL}"
		);

		for (var content : list "${contentList}") {
			AssertElementPresent(
				locator1 = "Fragment#EDITABLE_FIELD_CONTENT",
				key_text = "${content}"
			);
		}
	}
}