definition {
	macro downloadAndInstallApp {
		var key_appName = "${appName}";

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "Store"
		);

		Marketplace.signIn();

		Portlet.shutdownServer();

		Portlet.startServer();

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "Store"
		);

		Marketplace.downloadApp(appName = "${appName}");

		ProductMenu.gotoPortlet(
			category = "Apps",
			panel = "Control Panel",
			portlet = "Purchased"
		);

		Marketplace.installApp(appName = "${appName}");
	}

	macro downloadApp {
		SelectFrame(locator1 = "Store#MARKETPLACE_IFRAME");

		Type(locator1 = "Store#SEARCH_FIELD", value1 = "${appName}");

		Click(locator1 = "Store#SEARCH_BUTTON");

		var key_appName = "${appName}";

		Click(locator1 = "Store#APP_TITLE");

		Click(locator1 = "Store#DETAILS_PURCHASE_BUTTON");

		Click(locator1 = "Store#PURCHASE_SELECT_BUTTON");

		Check(locator1 = "Store#PURCHASE_AGREE_CHECKBOX");

		Click(locator1 = "Store#PURCHASE_BUTTON");

		AssertTextEquals(locator1 = "Store#RECEIPT_TITLE", value1 = "Receipt");

		AssertTextEquals(
			locator1 = "Store#RECEIPT_COMPLETED_THANK_YOU_MESSAGE",
			value1 = "Thank You!"
		);

		SelectFrame(value1 = "relative=top");
	}

	macro installApp {
		SelectFrame(locator1 = "Store#MARKETPLACE_IFRAME");

		Type(locator1 = "Store#PURCHASED_SEARCH_TITLE_FIELD", value1 = "${appName}");

		Click(locator1 = "Store#PURCHASED_SEARCH_BUTTON");

		Click(locator1 = "Store#PURCHASED_INSTALL_BUTTON");

		SelectFrame(value1 = "relative=top");

		Pause(locator1 = "5000");
	}

	macro signIn {
		SelectFrame(locator1 = "Store#MARKETPLACE_IFRAME");

		Type(locator1 = "Store#EMAIL_ADDRESS_FIELD", value1 = "${userEmailAddress}");

		Type(locator1 = "Store#PASSWORD_FIELD", value1 = "${userEmailPassword}");

		Click(locator1 = "Store#SIGN_IN_BUTTON");

		if (IsElementPresent(locator1 = "Store#UPDATE_BUTTON")) {
			Click(locator1 = "Store#UPDATE_BUTTON");
		}
	}

	macro smoke {
