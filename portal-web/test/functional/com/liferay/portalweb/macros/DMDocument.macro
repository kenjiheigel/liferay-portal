	macro removeDocumentViewPermissionsPG {
		var key_dmDocumentTitle = "${dmDocumentTitle}";
		var key_roleTitle = StringUtil.lowerCase('${key_roleTitle}');

		Check(locator1 = "DocumentsAndMedia#ICON_DOCUMENT_CHECKBOX");

		Click(locator1 = "DocumentsAndMedia#ICON_DOCUMENT_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Permissions");

		IFrame.selectPermissionsFrame();

		Uncheck(locator1 = "Permissions#CONFIGURATION_PERMISSIONS_VIEW_CHECKBOX");

		Button.clickSave();

		AssertTextEquals.assertPartialText(
			locator1 = "Permissions#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		SelectFrame(value1 = "relative=top");
