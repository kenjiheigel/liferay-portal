	macro navigateHomeViaDocumentViewPG {
		var key_breadcrumbName = "Home";

		AssertClick(locator1 = "BreadcrumbPortlet#BREADCRUMB_PAGE", value1 = "Home");
	}

	macro populateField {
		var key_fieldName = "${fieldName}";

		if (!("${fieldShowLabel}" == "No")) {
			AssertTextEquals(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#FIELD_LABEL",
				value1 = "${fieldFieldLabel}"
			);
		}
		else {
			AssertElementNotPresent(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#FIELD_LABEL"
			);
		}

		if ("${field}" == "Boolean") {
			if ("${dmDocumentTypeFieldData}" == "false") {
				Uncheck(locator1 = "DocumentsAndMediaEditCustomDocumentType#BOOLEAN_CHECKBOX");
			}
			else if ("${dmDocumentTypeFieldData}" == "true") {
				Check(locator1 = "DocumentsAndMediaEditCustomDocumentType#BOOLEAN_CHECKBOX");
			}
			else {
				fail("Invalid var recordFieldData. Must be (true|false).");
			}
		}

		if ("${field}" == "Date") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#DATE_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Decimal") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#DECIMAL_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Documents and Media") {
			AssertClick(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#DOCUMENTS_AND_MEDIA_SELECT",
				value1 = "Select"
			);

			SelectFrame(locator1 = "DocumentsAndMediaSelectDocument#SELECT_DOCUMENT_IFRAME");

			AssertClick(locator1 = "Toolbar#ADD", value1 = "Add");

			MenuItem.click(menuItem = "Basic Document");

			UploadCommonFile(locator1 = "TextInput#FILE", value1 = "${document}");

			PortletEntry.inputTitle(title = "${dmDocumentTypeFieldData}");

			AssertClick(locator1 = "Button#PUBLISH", value1 = "Publish");

			var key_documentTitle = "${dmDocumentTypeFieldData}";

			AssertTextEquals(
				locator1 = "DocumentsAndMediaSelectDocument#DOCUMENTS_TABLE_DOCUMENT",
				value1 = "${dmDocumentTypeFieldData}"
			);

			Click(locator1 = "DocumentsAndMediaSelectDocument#DOCUMENTS_TABLE_CHOOSE");

			SelectFrame(value1 = "relative=top");

			AssertTextEquals(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#DOCUMENTS_AND_MEDIA_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "HTML") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#HTML_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Integer") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#INTEGER_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Link to Page") {
			var key_ddlRecordFieldData = "${dmDocumentTypeFieldData}";

			Click(locator1 = "DocumentsAndMediaEditCustomDocumentType#LINK_TO_PAGE_SELECT");

			DoubleClick(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#LINK_TO_PAGE_SELECT_OPTION"
			);
		}

		if ("${field}" == "Number") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#NUMBER_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Radio") {
			var key_ddlRecordFieldData = "${dmDocumentTypeFieldData}";

			AssertTextEquals(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#RADIO_OPTION_LABEL",
				value1 = "${dmDocumentTypeFieldData}"
			);

			Click(locator1 = "DocumentsAndMediaEditCustomDocumentType#RADIO_OPTION_RADIO");
		}

		if ("${field}" == "Select") {
			Select(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#SELECT_SELECT",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Text") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#TEXT_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}

		if ("${field}" == "Text Box") {
			Type(
				locator1 = "DocumentsAndMediaEditCustomDocumentType#TEXT_BOX_FIELD",
				value1 = "${dmDocumentTypeFieldData}"
			);
		}
	}

