		);

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_ACTIONS_2");

		MenuItem.click(menuItem = "Complete Form");
	}

	macro completeFormForTaskViaRecordView {
		AssertClick(
			locator1 = "KaleoFormsViewProcessRecord#COMPLETE_FORM",
			value1 = "Complete Form"
		);
	}

	macro completeFormForTaskViaTable {
		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_TASK_1",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_SUBMISSION_DATE_1"
		);

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_ACTIONS_1");

		MenuItem.click(menuItem = "Complete Form");
	}

	macro populateFieldBoolean {
		var key_fieldName = "${fieldName}";

		if ("${kfProcessFieldData}" == "true") {
			Check(locator1 = "DDLEditRecord#BOOLEAN_CHECKBOX");
		}
		else if ("${kfProcessFieldData}" == "false") {
			Uncheck(locator1 = "DDLEditRecord#BOOLEAN_CHECKBOX");
		}
	}

	macro populateFieldDate {
		var key_fieldName = "${fieldName}";

		Type(locator1 = "DDLEditRecord#DATE_FIELD", value1 = "${kfProcessFieldData}");

		Click(locator1 = "DDLEditRecord#DATE_FIELD");
	}

	macro populateFieldDocumentsAndMedia {
		var key_fieldName = "${fieldName}";

		AssertClick(
			locator1 = "DDLEditRecord#DOCUMENTS_AND_MEDIA_CHOOSE_FROM_DOCUMENT_LIBRARY_BUTTON",
			value1 = "Select"
		);

		SelectFrame(locator1 = "DocumentsAndMediaSelectDocument#SELECT_DOCUMENT_IFRAME");

		AssertClick(locator1 = "Button#ADD", value1 = "Add");

		MenuItem.click(menuItem = "Basic Document");

		UploadCommonFile(
			locator1 = "DocumentsAndMediaEditDocument#FILE_FIELD",
			value1 = "${document}"
		);

		PortletEntry.inputTitle(title = "${kfProcessFieldData}");

		AssertClick(locator1 = "Button#PUBLISH", value1 = "Publish");

		var key_documentTitle = "${kfProcessFieldData}";

		AssertTextEquals(
			locator1 = "DocumentsAndMediaSelectDocument#DOCUMENTS_TABLE_DOCUMENT",
			value1 = "${kfProcessFieldData}"
		);

		Click(locator1 = "DocumentsAndMediaSelectDocument#DOCUMENTS_TABLE_CHOOSE");

		SelectFrame(value1 = "relative=top");

		AssertTextEquals(
			locator1 = "DDLEditRecord#DOCUMENTS_AND_MEDIA_FIELD",
			value1 = "${kfProcessFieldData}"
		);
	}

	macro populateFieldHTML {
		var key_fieldName = "${fieldName}";

		Type.typeCKEditor(
			locator1 = "DDLEditRecord#HTML_FIELD",
			value1 = "${kfProcessFieldData}"
		);
	}

	macro populateFieldLinkToPage {
		var key_ddlRecordFieldData = "${ddlRecordFieldData}";
		var key_fieldName = "${fieldName}";

		AssertClick(
			locator1 = "DDLEditRecord#LINK_TO_PAGE_SELECT_PAGE_BUTTON",
			value1 = "Select"
		);

		var key_navItem = "${pagePrivacy} Pages";

		AssertClick(
			locator1 = "DDLEditRecord#LINK_TO_PAGE_NAV_ITEM",
			value1 = "${pagePrivacy} Pages"
		);

		var key_pageName = "${ddlRecordFieldData}";

		Click(locator1 = "DDLEditRecord#LINK_TO_PAGE_PAGE_RADIO");

		AssertClick(locator1 = "Button#SELECT", value1 = "Select");

		AssertTextEquals(
			locator1 = "DDLEditRecord#LINK_TO_PAGE_PAGE_SELECT",
			value1 = "${ddlRecordFieldData}"
		);
	}

	macro populateFieldRadio {
		var key_fieldName = "${fieldName}";
		var key_kfProcessFieldData = "${kfProcessFieldData}";

		Click(locator1 = "DDLEditRecord#RADIO_OPTION_RADIO");
	}

	macro populateFieldSelect {
		var key_fieldName = "${fieldName}";

		Select(
			locator1 = "DDLEditRecord#SELECT_SELECT",
			value1 = "${kfProcessFieldData}"
		);
	}

	macro populateFieldText {
		var key_fieldName = "${fieldName}";

		Type(locator1 = "DDLEditRecord#TEXT_FIELD", value1 = "${kfProcessFieldData}");
	}

	macro populateFieldTextBox {
		var fieldName = StringUtil.replace('${fieldName}', ' ', '_');
		var key_fieldName = "${fieldName}";

		Type(
			locator1 = "DDLEditRecord#TEXT_BOX_FIELD",
			value1 = "${kfProcessFieldData}"
		);
	}

	macro rejectProcess {
		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_TASK_1",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_SUBMISSION_DATE_1"
		);

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_ACTIONS_1");

		MenuItem.click(menuItem = "Reject");

		AssertTextEquals(locator1 = "KaleoForms#DIALOG_BOX_TITLE", value1 = "Reject");

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();
	}

	macro resubmitPendingProcessViaInbox {
		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_TASK_1",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_SUBMISSION_DATE_1"
		);

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_ACTIONS_1");

		MenuItem.click(menuItem = "Resubmit");

		AssertTextEquals(locator1 = "KaleoForms#DIALOG_BOX_TITLE", value1 = "Resubmit");

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();
	}

	macro resubmitPendingProcessViaMyPendingRequests {
		AssertClick(
			locator1 = "KaleoFormsViewProcessRecord#TASKS_TABLE_UPDATE_ACTIONS",
			value1 = "Actions"
		);

		MenuItem.click(menuItem = "Resubmit");

		AssertTextEquals(locator1 = "KaleoForms#DIALOG_BOX_TITLE", value1 = "Resubmit");

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();
	}

	macro saveProcessRecord {
		PortletEntry.save();
	}

	macro submitNewProcess {
		AssertClick(locator1 = "KaleoForms#SUBMIT_NEW", value1 = "Submit New");

		var key_kfProcessName = "${kfProcessName}";

		MenuItem.click(menuItem = "${kfProcessName}");

		AssertTextEquals(
			locator1 = "DDLEditRecord#HEADER_TITLE",
			value1 = "New ${kfProcessName}"
		);
	}

	macro updateProcessDueDate {
		var key_kfProcessName = "${kfProcessName}";

		if (isSet(assignedToMyRoles)) {
			LexiconEntry.openEntryMenu(rowEntry = "${kfProcessName}");
		}
		else if (isSet(assignedToMe)) {
			Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_ACTIONS_1");
		}

		MenuItem.click(menuItem = "Update Due Date");

		AssertTextEquals(
			locator1 = "KaleoForms#DIALOG_BOX_TITLE",
			value1 = "Update Due Date"
		);

		Type(
			locator1 = "KaleoForms#DIALOG_BOX_UPDATE_DUE_DATE_DATE",
			value1 = "${kfProcessDueDateDate}"
		);

		Type(
			locator1 = "KaleoForms#DIALOG_BOX_UPDATE_DUE_DATE_TIME",
			value1 = "${kfProcessDueDateTime}"
		);

		Click(locator1 = "KaleoForms#DIALOG_BOX_UPDATE_DUE_DATE_DATE");

		Click(locator1 = "KaleoForms#DIALOG_BOX_UPDATE_DUE_DATE_TIME");

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();
	}

