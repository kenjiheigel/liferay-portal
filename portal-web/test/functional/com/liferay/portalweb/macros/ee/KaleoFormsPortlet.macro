	macro viewInboxProcessName {
		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#PROCESS_NAME",
			value1 = "${workflowTask}: ${kfProcessName}"
		);
	}

	macro viewMyCompletedRequests {
		AssertClick(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS",
			value1 = "My Completed Requests"
		);

		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_TABLE_STATUS",
			value1 = "Approved"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_TABLE_END_DATE"
		);

		AssertElementNotPresent(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_TABLE_EXTRA_COLUMN"
		);

		AssertClick(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#WORKFLOW_STATUS",
			value1 = "State Approved"
		);

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#WORKFLOW_DEFINITION",
			value1 = "${workflowDefinitionTitle}"
		);
	}

	macro viewMyCompletedRequestsAllComments {
		AssertClick(
			locator1 = "KaleoFormsViewProcessRecord#ACTIVITIES_PANEL_COLLAPSED",
			value1 = "Activities"
		);

		var i = "1";

		for (var comment : list "${commentList}") {
			AssertTextEquals(
				locator1 = "xpath=(//div[@class='task-activity-comment'])[${i}]",
				value1 = "${comment}"
			);

			var i = MathUtil.sum('${i}', '1');
		}

		AssertElementNotPresent(
			locator1 = "xpath=(//div[@class='task-activity-comment'])[${i}]"
		);
	}

	macro viewMyCompletedRequestsComment {
		var key_comment = "${comment}";

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#ACTIVITIES_COMMENT",
			value1 = "${comment}"
		);
	}

