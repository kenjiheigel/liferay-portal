		var key_fieldName = "${fieldName}";
		var key_kfProcessFieldData = "${kfProcessFieldData}";

		AssertTextEquals.assertPartialText(
			locator1 = "KaleoFormsViewProcessRecord#CURRENT_ENTRY_FIELD",
			value1 = "${kfProcessFieldData}"
		);
	}

