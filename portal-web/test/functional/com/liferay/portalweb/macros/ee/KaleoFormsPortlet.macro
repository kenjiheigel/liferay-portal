		);
	}

	macro viewMyCompletedRequestsTasks {
		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#TASKS_TABLE_REVIEW_TASK",
			value1 = "Review"
		);

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#TASKS_TABLE_REVIEW_COMPLETED",
			value1 = "Yes"
		);
	}

	macro viewMyPendingRequests {
		AssertClick(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS",
			value1 = "My Pending Requests"
		);

		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_STATUS",
			value1 = "${kfProcessStatus}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_END_DATE");

		AssertClick(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#WORKFLOW_STATUS",
			value1 = "State ${kfProcessStatus}"
		);

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#WORKFLOW_DEFINITION",
			value1 = "${workflowDefinitionTitle}"
		);
