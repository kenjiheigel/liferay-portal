			value1 = "${fieldName} ${kfProcessFieldData}"
		);
	}

	macro viewMyPendingRequestsTasksRejected {
		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#TASKS_TABLE_UPDATE_TASK",
			value1 = "Update"
		);

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#TASKS_TABLE_REVIEW_COMPLETED",
			value1 = "No"
		);
	}

	macro viewNoCompletedRequests {
		AssertClick(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS",
			value1 = "My Completed Requests"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#MY_COMPLETED_REQUESTS_INFO_MESSAGE",
			value1 = "There are no completed publications requested by me."
		);
	}

	macro viewNoPermissionPG {
		AssertTextEquals(
			locator1 = "Message#ERROR_1_COLUMN_1",
			value1 = "You do not have the roles required to access this portlet."
		);
	}

	macro viewNoTasks {
		Panel.expandPanel(panel = "Assigned to Me");

		PortletEntry.viewEmptyMessage(entity = "Tasks");

		Panel.expandPanel(panel = "Assigned to My Roles");

		AssertTextEquals(
			locator1 = "Message#EMPTY_INFO_2",
			value1 = "There are no tasks."
		);
	}

	macro viewProcessAssignedToMe {
		var key_kfProcessName = "${kfProcessName}";

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1");
	}

	macro viewProcessDueDate {
		var key_kfProcessName = "${kfProcessName}";

		if (isSet(assignedToMyRoles)) {
			Click(locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_NAME");
		}
		else if (isSet(assignedToMe)) {
			Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1");
		}

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#DUE_DATE_DATE",
			value1 = "Due Date ${kfProcessDueDateFormatted} - (Change)"
		);
	}

	macro viewProcessEntryField {
		var key_fieldName = "${fieldName}";
		var key_kfProcessFieldData = "${kfProcessFieldData}";

		AssertTextEquals(
			locator1 = "KaleoFormsViewProcessRecord#CURRENT_ENTRY_FIELD",
			value1 = "${fieldName} ${kfProcessFieldData}"
		);
	}

	macro viewSecondProcessAssignedToMe {
		var key_kfProcessName = "${kfProcessName}";

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_2");
	}

	macro withdrawSubmission {
		AssertClick(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS",
			value1 = "My Pending Requests"
		);

		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_STATUS",
			value1 = "${kfProcessStatus}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_END_DATE");

		LexiconEntry.openEntryMenu(rowEntry = "${kfProcessName}");

		MenuItem.click(menuItem = "Withdraw Submission");

		Alert.viewSuccessMessage();

		AssertTextNotPresent(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertTextNotPresent(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_STATUS",
			value1 = "${kfProcessStatus}"
		);

		AssertElementNotPresent(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementNotPresent(
			locator1 = "KaleoForms#MY_PENDING_REQUESTS_TABLE_END_DATE"
		);

		AssertTextEquals(
			locator1 = "Message#INFO",
			value1 = "There are no pending publications requested by me."
		);
	}
}