definition {
	macro approveProcess {
		Panel.expandPanel(panel = "Assigned to My Roles");

		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_TASK_1",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_SUBMISSION_DATE_1"
		);

		Click(locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_ACTIONS_1");

		MenuItem.click(menuItem = "Approve");

		AssertTextEquals(locator1 = "KaleoForms#DIALOG_BOX_TITLE", value1 = "Approve");

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();
	}

	macro assignProcessToMe {
		Panel.expandPanel(panel = "Assigned to Me");

		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_SUBMISSION_DATE"
		);

		AssertElementPresent(locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_ACTIONS");

		LexiconEntry.openEntryMenu(rowEntry = "${kfProcessName}");

		MenuItem.click(menuItem = "Assign to Me");

		AssertTextEquals(
			locator1 = "KaleoForms#DIALOG_BOX_TITLE",
			value1 = "Assign to Me"
		);

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_TASK_1",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_NAME_1",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_SUBMISSION_DATE_1"
		);
	}

	macro assignProcessToUser {
		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_NAME",
			value1 = "${kfProcessName}"
		);

		AssertElementPresent(
			locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_SUBMISSION_DATE"
		);

		AssertElementPresent(locator1 = "KaleoForms#ASSIGNED_TO_MY_ROLES_TABLE_ACTIONS");

		LexiconEntry.openEntryMenu(rowEntry = "${kfProcessName}");

		MenuItem.click(menuItem = "Assign to...");

		AssertTextEquals(
			locator1 = "KaleoForms#DIALOG_BOX_TITLE",
			value1 = "Assign to..."
		);

		Select(
			locator1 = "KaleoForms#DIALOG_BOX_ASSIGN_TO_SELECT",
			value1 = "${userFullName}"
		);

		if (isSet(comment)) {
			Type(locator1 = "KaleoForms#DIALOG_BOX_COMMENT_FIELD", value1 = "${comment}");
		}

		Button.clickDone();

		Alert.viewSuccessMessage();
	}

	macro completeFormForSecondProcessTaskViaTable {
		var key_kfProcessName = "${kfProcessName}";

		AssertTextEquals(
			locator1 = "KaleoForms#ASSIGNED_TO_ME_TABLE_TASK_2",
