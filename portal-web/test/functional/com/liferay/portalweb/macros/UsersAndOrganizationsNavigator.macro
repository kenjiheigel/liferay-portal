definition {
	macro gotoOrganizations {
		Pause(locator1 = "1000");

		if (IsElementPresent(locator1 = "NavBar#ORGANIZATIONS")) {
			AssertClick(locator1 = "NavBar#ORGANIZATIONS", value1 = "Organizations");
		}
	}

	macro gotoUsers {
		Pause(locator1 = "1000");

		if (IsElementPresent(locator1 = "NavBar#USERS")) {
			AssertClick(locator1 = "NavBar#USERS", value1 = "Users");
		}

		AssertVisible(locator1 = "UsersAndOrganizations#USER_TABLE_HEADER_FIRST_NAME");
	}
}