definition {
	macro addComment {
		Click(locator1 = "AlloyEditor#EDITOR", key_editor = "postReply");

		AlloyEditor.typeEditor(content = "${entryComment}", editor = "postReply");

		AssertClick(locator1 = "Button#REPLY", value1 = "Reply");

		Alert.viewSuccessMessage();
	}

	macro deleteComment {
		LexiconEntry.openEntryMenu(rowEntry = "${entryComment}");

		MenuItem.clickNoError(menuItem = "Delete");

		Confirm(
			value1 = "Are you sure you want to delete this? It will be deleted immediately."
		);

		Alert.viewSuccessMessage();
	}

	macro editComment {
		LexiconEntry.openEntryMenu(rowEntry = "${entryComment}");

		MenuItem.click(menuItem = "Edit");

		AlloyEditor.typeEditor(content = "${entryCommentEdit}", editor = "editReply");

		PortletEntry.publish();
	}

	macro subscribePG {
		AssertClick(
			locator1 = "Comments#SUBSCRIBE_TO_COMMENTS_LINK",
			value1 = "Subscribe to Comments"
		);

		Alert.viewSuccessMessage();
	}
}