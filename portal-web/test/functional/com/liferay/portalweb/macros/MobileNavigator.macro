definition {
	macro clickRemoveIcon {
		if (IsVisible.waitForVisible(locator1 = "Icon#REMOVE")) {
			Click(locator1 = "Icon#REMOVE");
		}
	}

	macro clickReorderButton {
		if (IsVisible(locator1 = "Icon#REMOVE")) {
			Click(locator1 = "Icon#REMOVE");
		}

		Click(locator1 = "Button#REORDER");
	}

	macro clickReorderIcon {
		if (IsVisible(locator1 = "Icon#REMOVE")) {
			Click(locator1 = "Icon#REMOVE");
		}

		Click(locator1 = "Icon#REORDER");
	}
}