definition {
	macro _gotoAddCollection {
		if (IsElementPresent(locator1 = "NavNested#NAV_NESTED_PLUS")) {
			Click(locator1 = "NavNested#NAV_NESTED_PLUS");
		}
		else {
			Button.click(button = "New");

			MenuItem.click(menuItem = "Collection");
		}
	}

	macro _gotoImportCollection {
		if (IsElementPresent(locator1 = "NavNested#NAV_NESTED_ELLIPSIS")) {
			Click(locator1 = "NavNested#NAV_NESTED_ELLIPSIS");
		}
		else {
			Button.click(button = "New");
		}

		MenuItem.click(menuItem = "Import");

		IFrame.selectConfigurationFrame();
	}

	macro addCollection {
		Fragment._gotoAddCollection();

		Collection.editCollection(
			collectionDescription = "${collectionDescription}",
			collectionName = "${collectionName}"
		);

		Button.clickSave();
	}

	macro addFragment {
		LexiconEntry.gotoAdd();

		AssertTextEquals(locator1 = "Modal#HEADER", value1 = "Add Fragment");

		PortletEntry.inputName(name = "${fragmentName}");

		Button.clickSave();
	}

	macro exportCollection {
		Navigator.gotoNavNested(navNested = "${collectionName}");

		LexiconEntry.gotoEllipsisMenuItem(menuItem = "Export");
	}

	macro importCollectionFromDependenciesFolder {
		Fragment._gotoImportCollection();

		UploadCommonFile(locator1 = "TextInput#FILE", value1 = "${collectionZipFile}");
	}

	macro importCollectionFromTempFolder {
		Fragment._gotoImportCollection();

		var tempDir = PropsUtil.get('output.dir.name');

		var pattern = StringUtil.split('**/collections-*.zip');
		var fileName = FileUtil.getIncludedResourceURLs('${pattern}', '${tempDir}');
		var fileName = StringUtil.valueOf('${fileName}');
		var fileName = RegexUtil.replace('${fileName}', '\[(.*)\]', '1');
		var shortFileName = FileUtil.getFileName('${fileName}');

		UploadTempFile(locator1 = "TextInput#FILE", value1 = "${shortFileName}");

		Button.click(button = "Import");

		Alert.viewSuccessMessage();

		IFrame.closeFrame();
	}

	macro typeFragmentEditor {
		var key_editor = StringUtil.toUpperCase('${editor}');

		Type.typeAceEditorNoError(
			locator1 = "Fragment#${key_editor}_EDITOR",
			value1 = "${templateScript}"
		);
	}
}