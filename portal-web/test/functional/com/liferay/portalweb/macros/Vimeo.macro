definition {
	macro addURL {
		SelectFrame(locator1 = "IFrame#CONFIGURATION_DIALOG");

		AssertTextEquals(locator1 = "Vimeo#URL_LABEL", value1 = "URL");

		if ("${enabledCheckbox}" == "true") {
			AssertClick(locator1 = "Vimeo#ADVANCED_OPTIONS", value1 = "Advanced Options");

			Check(locator1 = "Checkbox#ENABLE_FULLSCREEN");

			AssertChecked(locator1 = "Checkbox#ENABLE_FULLSCREEN");
		}
		else {
			Type(locator1 = "TextInput#URL", value1 = "${vimeoURL}");
		}

		Button.clickSave();

		AssertTextEquals(
			locator1 = "Message#SUCCESS",
			value1 = "You have successfully updated the setup."
		);

		SelectFrame(value1 = "relative=top");
	}

	macro view {
		AssertElementPresent(locator1 = "Vimeo#VIMEO_VIDEO");
	}
}