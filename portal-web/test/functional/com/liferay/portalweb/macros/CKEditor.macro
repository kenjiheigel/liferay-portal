definition {
	macro addContent {
		SelectFrame(locator1 = "CKEditor#BODY_FIELD_IFRAME");

		KeyPress(locator1 = "CKEditor#BODY", value1 = "${content}");

		SelectFrame(value1 = "relative=top");
	}

	macro assertEditorPresent {
		AssertElementPresent(locator1 = "CKEditor#BODY_FIELD");
	}

	macro selectHeading {
		Click(locator1 = "CKEditor#TOOLBAR_FORMAT_BUTTON");

		SelectFrame(locator1 = "CKEditor#IFRAME");

		var key_format = "${format}";

		Click(locator1 = "CKEditor#TOOLBAR_FORMAT_MENULIST", value1 = "${format}");

		SelectFrame(value1 = "relative=top");
	}

	macro typeEnterKey {
		SelectFrame(locator1 = "CKEditor#BODY_FIELD_IFRAME");

		KeyPress(locator1 = "CKEditor#BODY", value1 = "\RETURN");

		SelectFrame(value1 = "relative=top");
	}

	macro viewEntryContent {
		AssertTextEquals(locator1 = "CKEditor#BODY", value1 = "${content}");
	}
}